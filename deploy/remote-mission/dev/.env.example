# Copier en .env (à côté de compose.yaml). Aucun de ces fichiers n'est commité avec des valeurs réelles.

# Jeton entre le pipe d'Open WebUI et le service (à reporter dans la Valve TOKEN du pipe).
MYSKILLS_REMOTE_TOKEN=dev-local

# LLM : par défaut le LLM simulé (service llm-simule, aucun crédit). Pour un vrai LiteLLM, mettre son
# adresse et une clé virtuelle de dev, et ajouter son hôte à allowed_hosts dans remote.json.
LLM_PROVIDER=litellm
LITELLM_BASE_URL=http://llm-simule:4000/v1
LITELLM_API_KEY=cle-simulee

# Azure AI Foundry, sans LiteLLM : LLM_PROVIDER=foundry, le nom de la ressource
# (https://<ressource>.services.ai.azure.com) et sa clé. Les déploiements attendus sont claude-haiku-5-5,
# claude-sonnet-5-5 et claude-opus-5-5 (sinon, changer leurs noms dans opencode.foundry.json et models.foundry.json).
# LLM_PROVIDER=foundry
# FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_API_KEY=

# Facultatif : connexion à Open WebUI par GitLab (OIDC) au lieu d'un utilisateur unique sans connexion.
# WEBUI_AUTH=true
# OPENID_PROVIDER_URL=https://gitlab.exemple.local/.well-known/openid-configuration
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
