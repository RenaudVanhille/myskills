{
  "name": "entrees",
  "title": "Retour sur le modèle de données sans toucher aux schémas",
  "stages": [
    {"id": "domaines", "phase": "cadrage", "level": "moyen", "deliverables": ["domaines.json"], "optional": ["modele.json"]},
    {"id": "architectures", "phase": "solutioning", "level": "complexe", "inputs": ["domaines.json"], "deliverables": ["options.json"]},
    {"id": "schemas", "phase": "solutioning", "level": "simple", "inputs": ["options.json"], "deliverables": ["schemas/option-a.drawio"]},
    {"id": "interfaces", "phase": "solutioning", "level": "moyen", "after": ["architectures"], "inputs": ["options.json", "modele.json"],
     "deliverables": ["api.json"]}
  ]
}
