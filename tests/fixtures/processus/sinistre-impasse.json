  "flows": [
    {
      "from": "survenu",
      "to": "declarer"
    },
    {
      "from": "declarer",
      "to": "controler"
    },
    {
      "from": "controler",
      "to": "complet"
    },
    {
      "from": "complet",
      "to": "completer"
    },
    {
      "from": "completer",
      "to": "controler"
    },
    {
      "from": "complet",
      "to": "montant",
      "label": "oui"
    },
    {
      "from": "montant",
      "to": "expertiser",
      "label": "oui"
    },
    {
      "from": "expertiser",
      "to": "rapport"
    },
    {
      "from": "rapport",
      "to": "decider"
    },
    {
      "from": "montant",
      "to": "decider",
      "label": "non"
    },
    {
      "from": "decider",
      "to": "payer"
    },
    {
      "from": "payer",
      "to": "indemnise"
    },
    {
      "from": "payer",
      "to": "archiver"
    }
