{
  "missions": {
    "portail": {
      "repo": "origin",
      "title": "Portail sinistres",
      "web": "https://gitlab.exemple.local/archi/portail"
    }
  },
  "workdir": "clones",
  "allowed_hosts": [
    "gitlab.exemple.local",
    "litellm.litellm.svc.cluster.local"
  ],
  "agent": {
    "command": [
      "{python}",
      "{config_dir}/mock_agent.py",
      "{prompt_file}"
    ],
    "timeout": 120,
    "env": {
      "ANTHROPIC_BASE_URL": "http://litellm.litellm.svc.cluster.local:4000"
    },
    "continue_args": [
      "--continue"
    ]
  },
  "git": {
    "name": "myskills-remote",
    "email": "myskills-remote@exemple.local"
  },
  "access": {
    "provider": "file",
    "file": "acces.json"
  }
}