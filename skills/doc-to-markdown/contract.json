{
  "skill": "doc-to-markdown",
  "level": "simple",
  "inputs": [
    "Fichiers PDF, DOCX, PPTX, XLSX, XLS, DOC, PPT",
    "Images PNG, JPG, GIF, BMP, TIFF, WEBP",
    "Vidéos MP4, MOV, MKV, WEBM, AVI et enregistrements audio MP3, WAV, M4A (traités en local, flux réseau limités aux hôtes identifiés)",
    "Dossiers"
  ],
  "outputs": [
    "DOSSIER/<nom>.md",
    "DOSSIER/attachments/<nom>-N.<ext>, liées en relatif depuis le Markdown",
    "DOSSIER/attachments/<nom>-NN.png : images clés d'une vidéo, à décrire par vision",
    "DOSSIER/.myskills-tmp/<nom>-pages/page-N.png : pages à transcrire par vision, à supprimer ensuite"
  ],
  "scripts": [
    {
      "name": "convert.py",
      "role": "Convertit les documents en Markdown, en local.",
      "usage": "uv run scripts/convert.py FICHIER|DOSSIER [...] [--out DOSSIER] [--engine auto|markitdown|docling] [--classify [--domains a,b]] [--no-clean] [--skip-existing] [--jobs N] [--language fr]",
      "options": {
        "FICHIER|DOSSIER": "documents à convertir ; un dossier donne ses documents convertibles, sous-dossiers compris ; deux documents de même nom donnent <nom>-<extension>.md ; une vidéo ou un audio passe par video.py",
        "--out": "dossier de sortie (défaut : dossier courant)",
        "--engine": "moteur ; auto choisit Docling pour un PDF scanné (version épinglée, modèles lus dans le cache vérifié : doctor.py extraction --prefetch ; sans eux, repli sur MarkItDown)",
        "--classify": "classe d'abord avec classify.py (Laya)",
        "--domains": "avec --classify : domaines possibles",
        "--no-clean": "ne pas nettoyer le texte des PDF",
        "--skip-existing": "ne pas reconvertir un document dont le Markdown est plus récent (garde les corrections)",
        "--jobs": "documents convertis en même temps (défaut : jusqu'à 4 ; Docling, un à la fois)",
        "--language": "vidéo ou audio : langue parlée (fr, en...) ; défaut : détectée"
      },
      "report": {
        "format": "json",
        "description": "Objet : results (un objet par fichier, une ligne chacun), errors et warnings. Un objet par fichier.",
        "schema": {
          "type": "object",
          "required": [
            "results",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "results": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "output",
                      "type",
                      "engine",
                      "pages",
                      "images",
                      "needs_vision",
                      "warnings"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "output": {
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "image",
                          "pdf",
                          "office",
                          "autre"
                        ]
                      },
                      "engine": {
                        "enum": [
                          "copie",
                          "markitdown",
                          "docling"
                        ]
                      },
                      "pages": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "images": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "needs_vision": {
                        "type": "boolean"
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "hints": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "vision_pages": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "classification": {
                        "type": "object",
                        "required": [
                          "type",
                          "domaine",
                          "tables",
                          "engine",
                          "method",
                          "warnings"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "domaine": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "tables": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "engine": {
                            "enum": [
                              "markitdown",
                              "docling"
                            ]
                          },
                          "method": {
                            "type": "string"
                          },
                          "warnings": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "validation": {
                        "type": "object",
                        "required": [
                          "ok",
                          "errors",
                          "warnings"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "ok": {
                            "type": "boolean"
                          },
                          "errors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "warnings": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "output",
                      "type",
                      "engine",
                      "duration",
                      "images",
                      "segments",
                      "language",
                      "model",
                      "needs_vision",
                      "vision_pages",
                      "warnings",
                      "validation"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "output": {
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "video",
                          "audio"
                        ]
                      },
                      "engine": {
                        "enum": [
                          "whisper",
                          "images"
                        ],
                        "description": "whisper : transcrit ; images : images clés seules (modèle absent ou --no-audio)"
                      },
                      "duration": {
                        "type": "number",
                        "minimum": 0,
                        "description": "secondes"
                      },
                      "images": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "images clés extraites"
                      },
                      "segments": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "phrases transcrites"
                      },
                      "language": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "model": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "modèle de model-sources.json utilisé"
                      },
                      "needs_vision": {
                        "type": "boolean"
                      },
                      "vision_pages": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "validation": {
                        "type": "object",
                        "required": [
                          "ok",
                          "errors",
                          "warnings"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "ok": {
                            "type": "boolean"
                          },
                          "errors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "warnings": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "output",
                      "skipped"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "output": {
                        "type": "string"
                      },
                      "skipped": {
                        "const": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "error"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Une ligne par fichier en échec, plus les erreurs du lot."
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Avertissements du lot (ceux d'un fichier sont dans son résultat)."
            }
          }
        }
      },
      "exit_codes": {
        "0": "tous les fichiers sont convertis",
        "1": "au moins un fichier a échoué (error dans son résultat, repris dans errors)"
      }
    },
    {
      "name": "video.py",
      "role": "Convertit une vidéo ou un audio en Markdown, en local, flux réseau limités aux hôtes identifiés : images clés pour la vision, transcription faster-whisper avec un modèle épinglé du cache.",
      "usage": "uv run scripts/video.py FICHIER [...] [--out DOSSIER] [--language fr] [--model whisper-small] [--no-audio] [--interval 1.0] [--threshold 0.06] [--max-frames 40]",
      "options": {
        "FICHIER": "vidéos ou enregistrements audio",
        "--out": "dossier de sortie (défaut : dossier courant)",
        "--language": "langue parlée ; défaut : détectée",
        "--model": "modèle de model-sources.json (défaut : whisper-small)",
        "--no-audio": "images clés seulement",
        "--interval": "secondes entre deux images comparées",
        "--threshold": "écart moyen (0 à 1) qui fait garder une image",
        "--max-frames": "images clés au plus par vidéo"
      },
      "report": {
        "format": "json",
        "description": "Objet : results (un objet par fichier), errors et warnings.",
        "schema": {
          "type": "object",
          "required": [
            "results",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "output",
                      "type",
                      "engine",
                      "duration",
                      "images",
                      "segments",
                      "language",
                      "model",
                      "needs_vision",
                      "vision_pages",
                      "warnings",
                      "validation"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "output": {
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "video",
                          "audio"
                        ]
                      },
                      "engine": {
                        "enum": [
                          "whisper",
                          "images"
                        ],
                        "description": "whisper : transcrit ; images : images clés seules (modèle absent ou --no-audio)"
                      },
                      "duration": {
                        "type": "number",
                        "minimum": 0,
                        "description": "secondes"
                      },
                      "images": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "images clés extraites"
                      },
                      "segments": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "phrases transcrites"
                      },
                      "language": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "model": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "modèle de model-sources.json utilisé"
                      },
                      "needs_vision": {
                        "type": "boolean"
                      },
                      "vision_pages": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "validation": {
                        "type": "object",
                        "required": [
                          "ok",
                          "errors",
                          "warnings"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "ok": {
                            "type": "boolean"
                          },
                          "errors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "warnings": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "error"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "tous les fichiers sont convertis (sans modèle : images clés seules, avec avertissement)",
        "1": "fichier introuvable ou illisible, audio sans modèle, modèle inconnu"
      }
    },
    {
      "name": "validate.py",
      "role": "Vérifie un Markdown converti, ou une note Obsidian avec --obsidian.",
      "usage": "uv run scripts/validate.py FICHIER.md [...] [--obsidian] [--vault DOSSIER] [--quiet]",
      "options": {
        "FICHIER.md": "Markdown à vérifier",
        "--obsidian": "vérifie aussi frontmatter, embeds et wikilinks",
        "--vault": "racine du vault",
        "--quiet": "ne lister que les fichiers avec une erreur ou un avertissement"
      },
      "report": {
        "format": "json",
        "description": "Objet : results (un objet par fichier, une ligne chacun), errors et warnings. Un objet par fichier (avec --quiet, seulement ceux qui ont une erreur ou un avertissement) ; un fichier introuvable donne ok false.",
        "schema": {
          "type": "object",
          "required": [
            "results",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "results": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "ok",
                  "errors",
                  "warnings"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "warnings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Une ligne par fichier en échec, plus les erreurs du lot."
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Avertissements du lot (ceux d'un fichier sont dans son résultat)."
            }
          }
        }
      },
      "exit_codes": {
        "0": "aucune erreur",
        "1": "au moins un fichier a une erreur"
      }
    },
    {
      "name": "classify.py",
      "role": "Classe des documents (type, domaine, moteur conseillé) avec le modèle local Laya lu dans le cache vérifié (doctor.py extraction --prefetch, aucun téléchargement pendant le run), ou par règles.",
      "usage": "uv run scripts/classify.py FICHIER|DOSSIER [...] [--domains a,b] [--min-confidence 0.5] [--rules-only]",
      "options": {
        "FICHIER|DOSSIER": "documents ou dossiers",
        "--domains": "domaines possibles : a,b ou a:description,b:description",
        "--min-confidence": "confiance minimale pour retenir type et domaine (défaut 0.5)",
        "--rules-only": "ne pas charger Laya"
      },
      "report": {
        "format": "json",
        "description": "Objet : results (un objet par fichier, une ligne chacun), errors et warnings. Un objet par fichier ; type et domaine valent null sous le seuil de confiance.",
        "schema": {
          "type": "object",
          "required": [
            "results",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "results": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "type",
                      "type_confidence",
                      "domaine",
                      "domaine_confidence",
                      "tables",
                      "engine",
                      "method",
                      "warnings"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "specification",
                          "architecture",
                          "procedure",
                          "compte-rendu",
                          "presentation",
                          "contrat",
                          "rapport",
                          "autre",
                          null
                        ]
                      },
                      "type_confidence": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "domaine": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "domaine_confidence": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "tables": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1
                      },
                      "engine": {
                        "enum": [
                          "markitdown",
                          "docling"
                        ]
                      },
                      "method": {
                        "type": "string",
                        "pattern": "^(regles|laya \\(.*\\))$"
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "error"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Une ligne par fichier en échec, plus les erreurs du lot."
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Avertissements du lot (ceux d'un fichier sont dans son résultat)."
            }
          }
        }
      },
      "exit_codes": {
        "0": "tous les fichiers sont classés",
        "1": "au moins un fichier a échoué"
      }
    }
  ],
  "requires": [
    {
      "skill": "check-prerequisites",
      "script": "lib/model_store.py",
      "why": "modèles locaux : cache vérifié et flux réseau filtrés (guard_network)"
    }
  ],
  "handoffs": [
    {
      "to": "markdown-to-obsidian",
      "kind": "skill",
      "when": "la cible est un vault Obsidian"
    },
    {
      "to": "schema-designer",
      "kind": "agent",
      "when": "un schéma en image doit devenir modifiable"
    }
  ]
}
