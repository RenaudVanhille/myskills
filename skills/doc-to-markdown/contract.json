{
  "skill": "doc-to-markdown",
  "inputs": [
    "Fichiers PDF, DOCX, PPTX, XLSX, XLS, DOC, PPT",
    "Images PNG, JPG, GIF, BMP, TIFF, WEBP",
    "Dossiers"
  ],
  "outputs": [
    "DOSSIER/<nom>.md",
    "DOSSIER/attachments/<nom>-N.<ext>, liées en relatif depuis le Markdown",
    "DOSSIER/.myskills-tmp/<nom>-pages/page-N.png : pages à transcrire par vision, à supprimer ensuite"
  ],
  "scripts": [
    {
      "name": "convert.py",
      "role": "Convertit les documents en Markdown, en local.",
      "usage": "uv run scripts/convert.py FICHIER|DOSSIER [...] [--out DOSSIER] [--engine auto|markitdown|docling] [--classify [--domains a,b]] [--no-clean] [--skip-existing]",
      "options": {
        "FICHIER|DOSSIER": "documents à convertir ; un dossier donne ses documents convertibles, sous-dossiers compris ; deux documents de même nom donnent <nom>-<extension>.md",
        "--out": "dossier de sortie (défaut : dossier courant)",
        "--engine": "moteur ; auto choisit Docling pour un PDF scanné",
        "--classify": "classe d'abord avec classify.py (Laya)",
        "--domains": "avec --classify : domaines possibles",
        "--no-clean": "ne pas nettoyer le texte des PDF",
        "--skip-existing": "ne pas reconvertir un document dont le Markdown est plus récent (garde les corrections)"
      },
      "report": {
        "format": "json",
        "description": "Un objet par fichier.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "input",
                  "output",
                  "type",
                  "engine",
                  "pages",
                  "images",
                  "needs_vision",
                  "warnings"
                ],
                "additionalProperties": false,
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "output": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "image",
                      "pdf",
                      "office",
                      "autre"
                    ]
                  },
                  "engine": {
                    "enum": [
                      "copie",
                      "markitdown",
                      "docling"
                    ]
                  },
                  "pages": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "images": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "needs_vision": {
                    "type": "boolean"
                  },
                  "warnings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "hints": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "vision_pages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "classification": {
                    "type": "object",
                    "required": [
                      "type",
                      "domaine",
                      "tables",
                      "engine",
                      "method",
                      "warnings"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "domaine": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "tables": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "engine": {
                        "enum": [
                          "markitdown",
                          "docling"
                        ]
                      },
                      "method": {
                        "type": "string"
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "validation": {
                    "type": "object",
                    "required": [
                      "ok",
                      "errors",
                      "warnings"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "ok": {
                        "type": "boolean"
                      },
                      "errors": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "input",
                  "output",
                  "skipped"
                ],
                "additionalProperties": false,
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "output": {
                    "type": "string"
                  },
                  "skipped": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "input",
                  "error"
                ],
                "additionalProperties": false,
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      },
      "exit_codes": {
        "0": "tous les fichiers sont convertis",
        "1": "au moins un fichier a échoué (objet avec error)"
      }
    },
    {
      "name": "validate.py",
      "role": "Vérifie un Markdown converti, ou une note Obsidian avec --obsidian.",
      "usage": "uv run scripts/validate.py FICHIER.md [...] [--obsidian] [--vault DOSSIER] [--quiet]",
      "options": {
        "FICHIER.md": "Markdown à vérifier",
        "--obsidian": "vérifie aussi frontmatter, embeds et wikilinks",
        "--vault": "racine du vault",
        "--quiet": "ne lister que les fichiers avec une erreur ou un avertissement"
      },
      "report": {
        "format": "json",
        "description": "Un objet par fichier (avec --quiet, seulement ceux qui ont une erreur ou un avertissement) ; un fichier introuvable donne ok false.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "ok",
              "errors",
              "warnings"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "aucune erreur",
        "1": "au moins un fichier a une erreur"
      }
    },
    {
      "name": "classify.py",
      "role": "Classe des documents (type, domaine, moteur conseillé) avec le modèle local Laya, ou par règles.",
      "usage": "uv run scripts/classify.py FICHIER|DOSSIER [...] [--domains a,b] [--min-confidence 0.5] [--rules-only]",
      "options": {
        "FICHIER|DOSSIER": "documents ou dossiers",
        "--domains": "domaines possibles : a,b ou a:description,b:description",
        "--min-confidence": "confiance minimale pour retenir type et domaine (défaut 0.5)",
        "--rules-only": "ne pas charger Laya"
      },
      "report": {
        "format": "json",
        "description": "Un objet par fichier ; type et domaine valent null sous le seuil de confiance.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "input",
                  "type",
                  "type_confidence",
                  "domaine",
                  "domaine_confidence",
                  "tables",
                  "engine",
                  "method",
                  "warnings"
                ],
                "additionalProperties": false,
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "specification",
                      "architecture",
                      "procedure",
                      "compte-rendu",
                      "presentation",
                      "contrat",
                      "rapport",
                      "autre",
                      null
                    ]
                  },
                  "type_confidence": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "domaine": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "domaine_confidence": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "tables": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "engine": {
                    "enum": [
                      "markitdown",
                      "docling"
                    ]
                  },
                  "method": {
                    "type": "string",
                    "pattern": "^(regles|laya \\(.*\\))$"
                  },
                  "warnings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "input",
                  "error"
                ],
                "additionalProperties": false,
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      },
      "exit_codes": {
        "0": "tous les fichiers sont classés",
        "1": "au moins un fichier a échoué"
      }
    }
  ],
  "handoffs": [
    {
      "to": "markdown-to-obsidian",
      "kind": "skill",
      "when": "la cible est un vault Obsidian"
    },
    {
      "to": "schema-designer",
      "kind": "agent",
      "when": "un schéma en image doit devenir modifiable"
    }
  ]
}
