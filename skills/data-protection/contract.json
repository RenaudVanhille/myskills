{
  "skill": "data-protection",
  "level": "complexe",
  "inputs": [
    "Description JSON des traitements de données personnelles et des risques pour les personnes (dpia_build.py --schema)",
    "Facultatif : exigences.json (requirements-catalog) et le .threats.md (threat-model), cités par les mesures ; l'hébergeur (shared/providers.json)"
  ],
  "outputs": [
    "<nom>.registre.md : fiches du registre des traitements (art. 30)",
    "<nom>.aipd.md : analyse d'impact (critères, risques, carte gravité × vraisemblance, mesures, résiduels, points à valider)"
  ],
  "scripts": [
    {
      "name": "dpia_build.py",
      "role": "Contrôle la description des traitements et des risques (nécessité de l'AIPD selon les critères du CEPD, base légale, données sensibles, durée de conservation, transferts hors EEE sans garantie, hébergeur extraterritorial, événements redoutés couverts, résiduel jamais supérieur à l'initial, résiduel élevé qui appelle la consultation de la CNIL, références vers les exigences et les menaces), calcule les niveaux et la carte des risques, écrit le registre et l'AIPD ; propose ce qui se déduit sans jugement : critères du CEPD tirés des données, et pour chaque risque sources, impacts et mesures (exigences de sécurité, conformité, disponibilité ; menaces STRIDE des flux du traitement et des stockages) quand la description ne les donne pas.",
      "usage": "uv run scripts/dpia_build.py AIPD.json [--draft] [--out-dir DOSSIER] [--vault VAULT --folder DOSSIER_DU_VAULT] | --schema",
      "options": {
        "AIPD.json": "description des traitements et des risques",
        "--draft": "écrire seulement <nom>.draft.json : un risque par traitement et événement redouté encore sans risque, avec sources, impacts et mesures proposés, à coter",
        "--out-dir": "dossier du registre et de l'AIPD (défaut : celui du .json)",
        "--vault": "vault Obsidian où écrire une note traitement par traitement et une note risque par risque",
        "--folder": "dossier des notes dans le vault, celui du workflow ; avec --vault",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
      "exit_codes": {
        "0": "registre et AIPD écrits (avertissements possibles : critères, résiduels élevés, événements non couverts) ; avec --draft, propositions écrites",
        "1": "description invalide, traitement ou référence inconnus, transfert hors EEE sans garantie, conservation manquante, résiduel supérieur à l'initial ; aucun fichier produit"
      },
      "input": {
        "format": "json",
        "description": "Traitements et risques pour les personnes.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "controller",
            "treatments"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "controller": {
              "type": "string",
              "description": "responsable du traitement"
            },
            "dpo": {
              "type": "string"
            },
            "requirements": {
              "type": "string",
              "description": "exigences.json (requirements-catalog), relatif à la description : refs vérifiées"
            },
            "threats": {
              "type": "string",
              "description": ".threats.md (threat-model) : menaces M001... citables par les mesures"
            },
            "hosting": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider"
              ],
              "properties": {
                "provider": {
                  "type": "string"
                }
              }
            },
            "criteria": {
              "type": "array",
              "items": {
                "enum": [
                  "evaluation",
                  "decision-automatique",
                  "surveillance",
                  "donnees-sensibles",
                  "grande-echelle",
                  "croisement",
                  "personnes-vulnerables",
                  "usage-innovant",
                  "exclusion"
                ]
              },
              "description": "critères du CEPD remplis : deux au moins rendent l'AIPD obligatoire"
            },
            "treatments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "purpose",
                  "legal_basis",
                  "subjects",
                  "data",
                  "retention"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9]*([-_.][A-Za-z0-9]+)*$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "purpose": {
                    "type": "string"
                  },
                  "legal_basis": {
                    "enum": [
                      "consentement",
                      "contrat",
                      "obligation-legale",
                      "interet-vital",
                      "mission-publique",
                      "interet-legitime"
                    ]
                  },
                  "art9_exception": {
                    "type": "string",
                    "description": "exception de l'article 9.2 pour des données sensibles"
                  },
                  "subjects": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "data": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "category"
                      ],
                      "properties": {
                        "category": {
                          "type": "string"
                        },
                        "sensitive": {
                          "type": "boolean"
                        },
                        "examples": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "recipients": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "retention": {
                    "type": "string"
                  },
                  "minimisation": {
                    "type": "string"
                  },
                  "transfers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "country"
                      ],
                      "properties": {
                        "country": {
                          "type": "string"
                        },
                        "mechanism": {
                          "enum": [
                            "adequation",
                            "clauses-types",
                            "bcr",
                            "derogation",
                            "aucun"
                          ]
                        }
                      }
                    }
                  },
                  "flows": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "flux de l'architecture (F1, F2...) qui portent les données"
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "exigences liées"
                  }
                }
              }
            },
            "risks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "treatment",
                  "event",
                  "gravity",
                  "likelihood"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9]*([-_.][A-Za-z0-9]+)*$"
                  },
                  "treatment": {
                    "type": "string"
                  },
                  "event": {
                    "enum": [
                      "acces-illegitime",
                      "modification-non-desiree",
                      "disparition"
                    ]
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "proposées par le script si absentes"
                  },
                  "impacts": {
                    "type": "string",
                    "description": "proposés par le script si absents"
                  },
                  "gravity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "likelihood": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "measures": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "text"
                      ],
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "kind": {
                          "enum": [
                            "existante",
                            "prevue"
                          ]
                        },
                        "refs": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "description": "proposées par le script si absentes (exigences et menaces)"
                  },
                  "residual": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "gravity",
                      "likelihood"
                    ],
                    "properties": {
                      "gravity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4
                      },
                      "likelihood": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4
                      }
                    }
                  },
                  "status": {
                    "enum": [
                      "ouvert",
                      "attenue",
                      "accepte"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Compteurs, nécessité de l'AIPD, résiduels élevés, transferts hors EEE, notes du vault.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "outputs",
            "treatments",
            "risks",
            "aipd",
            "residual_high",
            "transfers_out",
            "vault",
            "errors",
            "warnings",
            "proposed",
            "criteria_added",
            "draft",
            "to_rate"
          ],
          "properties": {
            "input": {
              "type": "string"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "treatments": {
              "type": "integer",
              "minimum": 0
            },
            "risks": {
              "type": "integer",
              "minimum": 0
            },
            "aipd": {
              "enum": [
                "requise",
                "non-requise",
                null
              ]
            },
            "residual_high": {
              "type": "integer",
              "minimum": 0
            },
            "transfers_out": {
              "type": "integer",
              "minimum": 0
            },
            "vault": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "vault",
                    "folder",
                    "notes",
                    "removed"
                  ],
                  "properties": {
                    "vault": {
                      "type": "string"
                    },
                    "folder": {
                      "type": "string"
                    },
                    "notes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "removed": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "proposed": {
              "type": "integer",
              "minimum": 0,
              "description": "champs de risque (sources, impacts, measures) remplis par proposition"
            },
            "criteria_added": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "critères du CEPD déduits des données et ajoutés"
            },
            "draft": {
              "type": [
                "string",
                "null"
              ],
              "description": "<nom>.draft.json avec --draft"
            },
            "to_rate": {
              "type": "integer",
              "minimum": 0,
              "description": "risques proposés par --draft, à coter"
            }
          }
        }
      }
    }
  ],
  "vault": {
    "writes": [
      "traitement",
      "risque"
    ],
    "reads": true
  },
  "requires": [
    {
      "skill": "markdown-to-obsidian",
      "script": "lib/vault_ontology.py",
      "why": "ontologie du vault Obsidian (source unique) : construire et vérifier les notes écrites"
    }
  ],
  "handoffs": [
    {
      "to": "threat-model",
      "kind": "skill",
      "when": "les menaces STRIDE de l'architecture ne sont pas encore analysées : elles nourrissent les risques et les mesures"
    },
    {
      "to": "decision-log",
      "kind": "skill",
      "when": "noter au journal un risque accepté et sa raison, soumettre l'AIPD à la revue"
    },
    {
      "to": "document-publisher",
      "kind": "agent",
      "when": "le registre ou l'AIPD doivent être livrés en Word ou PDF"
    },
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "faire valider l'analyse par le délégué à la protection des données et décider d'un risque résiduel élevé"
    }
  ]
}
