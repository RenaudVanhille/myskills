    {
      "name": "iac_import.py",
      "role": "Écrit la description de cloud_build.py depuis le code d'infrastructure : ressources Terraform (AWS, Azure, Google), services docker-compose et manifestes Kubernetes deviennent services typés, réseaux et namespaces des groupes, références et dépendances des flux ; la description est validée contre le schéma d'entrée de cloud_build.py et construite à blanc avant d'être écrite.",
      "usage": "uv run scripts/iac_import.py SOURCE [...] [--out SUJET.json] [--title T]",
      "options": {
        "SOURCE": "fichier .tf, docker-compose (.yml) ou manifeste Kubernetes (.yaml), ou dossier qui en contient",
        "--out": "description écrite (défaut : <première source>.cloud.json)",
        "--title": "titre du schéma (défaut : nom de la première source)"
      },
      "report": {
        "format": "json",
        "description": "Un objet : sources lues par format, fournisseur retenu, compteurs ; ignored compte les ressources sans équivalent, nommées dans warnings.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "input",
            "output",
            "sources",
            "provider",
            "groups",
            "services",
            "flows",
            "ignored",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "sources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "terraform": {
                  "type": "integer",
                  "minimum": 1
                },
                "compose": {
                  "type": "integer",
                  "minimum": 1
                },
                "kubernetes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "provider": {
              "enum": [
                "aws",
                "azure",
                "gcp",
                "k8s",
                null
              ]
            },
            "groups": {
              "type": "integer",
              "minimum": 0
            },
            "services": {
              "type": "integer",
              "minimum": 0
            },
            "flows": {
              "type": "integer",
              "minimum": 0
            },
            "ignored": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "description écrite, conforme et construite sans erreur",
        "1": "source introuvable ou format non reconnu, aucune ressource reconnue, ressource en double, ou description produite rejetée par cloud_build.py ; rien n'est écrit"
      }
    }
  ],
  "handoffs": [
    {
      "to": "diagram-export",
      "kind": "skill",
      "when": "exporter et relire l'image"
    },
    {
