              "enum": [
                "deployment",
                "network",
                "kubernetes",
                "dr",
                "pipeline",
                "threats"
              ]
            },
            "audience": {
              "enum": [
                "technique",
                "non technique"
              ]
            },
            "legend": {
              "enum": [
                "auto",
                true,
                false
              ]
            },
            "layout": {
              "enum": [
                "row",
                "column"
              ]
            },
            "wrap": {
              "type": "integer",
