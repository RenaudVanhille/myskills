{
  "skill": "cloud-architecture",
  "inputs": [
    "Décision de diagram-brief : public et destination",
    "Description JSON de l'architecture : title, provider, view, items (groupes imbriqués et services typés), flows, objectives ; ou du code d'infrastructure (Terraform, docker-compose, manifestes Kubernetes) que iac_import.py traduit en description"
  ],
  "outputs": [
    "<sujet>.drawio en XML clair, avec les icônes officielles AWS, Azure, GCP ou Kubernetes, à côté de sa description <sujet>.json",
    "Vue network (ou --matrix) : <sujet>.flows.md, la matrice des flux",
    "Avec stride.py : <sujet>.threats.md, le modèle de menaces STRIDE à compléter",
    "Après export : <sujet>.drawio.png (une image par page), .svg ou .pdf"
  ],
  "scripts": [
    {
      "name": "cloud_build.py",
      "role": "Construit le schéma draw.io (mise en page des groupes imbriqués, icônes officielles livrées dans draw.io, flux, titre, RPO/RTO, légende), puis le vérifie avec check_drawio.py du skill drawio-diagram s'il est installé.",
      "usage": "uv run scripts/cloud_build.py SUJET.json [--out SUJET.drawio] [--view deployment|network|kubernetes|dr|pipeline|threats] [--matrix] | --types [aws|azure|gcp|k8s|generic] | --schema",
      "options": {
        "SUJET.json": "description de l'architecture",
        "--out": "fichier .drawio (défaut : même nom)",
        "--view": "vue, prioritaire sur celle de la description",
        "--matrix": "écrit aussi <sujet>.flows.md (toujours en vue network)",
        "--types": "liste les types de services et de groupes connus, puis s'arrête",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
