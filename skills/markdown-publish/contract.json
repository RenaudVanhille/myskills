{
  "skill": "markdown-publish",
  "level": "simple",
  "inputs": [
    "Markdown ou notes Obsidian, avec leurs images et schémas sources",
    "Modèle Word ou gabarit PowerPoint .potx (facultatif)",
    "Vault Obsidian (facultatif)"
  ],
  "outputs": [
    "<nom>.docx, <nom>.html, <nom>.xwiki et ses images dans <nom>-xwiki/",
    "<nom>.pptx, par le skill externe markdown-to-pptx s'il est installé",
    "En option : PDF, planches PNG des pages à relire dans .myskills-tmp/<nom>-apercu/"
  ],
  "scripts": [
    {
      "name": "publish.py",
      "role": "Produit Word, HTML ou XWiki à partir d'un Markdown, schémas compris, sans rien publier.",
      "usage": "uv run scripts/publish.py DOC.md [...] [--to docx,html,xwiki] [--out DOSSIER] [--reference-doc modele.docx] [--toc] [--pdf] [--preview | --preview-all] [--vault VAULT]",
      "options": {
        "DOC.md": "documents à publier",
        "--to": "formats, séparés par des virgules (défaut docx)",
        "--out": "dossier de sortie",
        "--reference-doc": "modèle Word",
        "--toc": "table des matières",
        "--pdf": "docx : PDF en plus (LibreOffice)",
        "--preview": "docx : planches PNG des seules pages à relire (images, tableaux, titre en bas de page)",
        "--preview-all": "docx : aperçu PNG de chaque page",
        "--vault": "vault Obsidian, pour retrouver les pièces jointes"
      },
      "report": {
        "format": "json",
        "description": "Objet : results (un objet par fichier, une ligne chacun), errors et warnings. Un objet par document.",
        "schema": {
          "type": "object",
          "required": [
            "results",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "results": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "outputs",
                      "diagrams_exported",
                      "warnings"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "outputs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "format",
                            "file",
                            "images",
                            "tables"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "format": {
                              "enum": [
                                "docx",
                                "html",
                                "xwiki"
                              ]
                            },
                            "file": {
                              "type": "string"
                            },
                            "images": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "tables": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "pdf": {
                              "type": "string"
                            },
                            "preview": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "preview_pages": {
                              "type": "array",
                              "items": {
                                "type": "integer",
                                "minimum": 1
                              }
                            }
                          }
                        }
                      },
                      "diagrams_exported": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "error": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "error"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Une ligne par fichier en échec, plus les erreurs du lot."
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Avertissements du lot (ceux d'un fichier sont dans son résultat)."
            }
          }
        }
      },
      "exit_codes": {
        "0": "tous les documents sont produits",
        "1": "au moins un document a échoué"
      }
    },
    {
      "name": "pptx_publish.py",
      "role": "Produit une présentation PowerPoint modifiable avec le skill markdown-to-pptx, installé à part et appelé par son seul contrat d'interface : vérifie le Markdown (images en PNG, JPEG ou SVG, textes alternatifs, consignes de visuel connues), lance le skill dans le dossier du Markdown, valide le plan rendu contre le contrat puis rouvre le .pptx (diapositives, images, textes alternatifs).",
      "usage": "uv run scripts/pptx_publish.py DOC.md [--out DOSSIER] [--template MARQUE.potx] [--lang fr|en]",
      "options": {
        "DOC.md": "document Markdown écrit selon les conventions du contrat (front matter, un titre #, une section ## par diapositive, consigne <!-- slide: KIND -->)",
        "--out": "dossier de sortie (défaut : à côté du Markdown)",
        "--template": "gabarit .potx de la marque ; sinon celui que choisit le skill (MD2PPTX_TEMPLATE, dossier .md2pptx/ du projet, gabarit du skill)",
        "--lang": "langue des libellés générés (défaut : détectée)"
      },
      "report": {
        "format": "json",
        "description": "Un objet : dossier et version du skill utilisé, diapositives, nombre par type, images, objets sans texte alternatif.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "input",
            "output",
            "skill",
            "version",
            "slides",
            "kinds",
            "images",
            "missing_alt",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "string"
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "skill": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "slides": {
              "type": "integer",
              "minimum": 0
            },
            "kinds": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "images": {
              "type": "integer",
              "minimum": 0
            },
            "missing_alt": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "présentation écrite et vérifiée",
        "1": "Markdown, image ou gabarit invalide, skill markdown-to-pptx introuvable (avec la consigne d'installation), rendu en échec ou présentation incohérente ; aucun .pptx laissé"
      }
    },
    {
      "name": "make_reference.py",
      "role": "Régénère references/modele.docx aux couleurs de la charte.",
      "maintenance": true,
      "usage": "uv run scripts/make_reference.py [--out references/modele.docx]",
      "report": {
        "format": "none"
      },
      "exit_codes": {
        "0": "modèle écrit"
      }
    }
  ],
  "handoffs": [
    {
      "to": "diagram-export",
      "kind": "skill",
      "when": "exporter les schémas (automatique)"
    },
    {
      "to": "markdown-to-pptx",
      "kind": "externe",
      "when": "produire le .pptx (pptx_publish.py le lance)"
    },
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "importer les fichiers dans SharePoint, Confluence ou XWiki, ou présenter le .pptx"
    }
  ],
  "requires": [
    {
      "skill": "diagram-export",
      "script": "export.py",
      "why": "exporter en image les schémas cités par le Markdown (sources .drawio, .excalidraw, .mmd, .c4)",
      "optional": false
    }
  ]
}
