  ],
  "requires": [
    {
      "skill": "requirements-catalog",
      "script": "req_build.py",
      "why": "valider exigences.json contre son schéma",
      "optional": true
    },
    {
      "skill": "architecture-options",
      "script": "options_build.py",
      "why": "valider options.json et reprendre les composants de l'option",
      "optional": true
    },
    {
      "skill": "solution-estimate",
      "script": "estimate_build.py",
      "why": "contrôler les lots backend contre le schéma des lots du chiffrage",
      "optional": true
    }
  ],
  "handoffs": [
    {
      "to": "architecture-review",
      "kind": "skill",
      "when": "les interfaces doivent être revues avec l'architecture (traçabilité, dépendances synchrones)"
    },
    {
      "to": "document-publisher",
      "kind": "agent",
      "when": "les contrats doivent être livrés dans un dossier Word, HTML ou XWiki"
    },
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "une exigence fonctionnelle indispensable n'a pas d'interface : l'ajouter ou dire qu'elle est hors API"
    },
    {
      "to": "backend-estimator",
      "kind": "agent",
      "when": "un chiffrage du backend est demandé : découper et estimer les lots depuis les interfaces"
    }
  ]
}
