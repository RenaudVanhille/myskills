              "minimum": 0
            },
            "integrations": {
              "type": "integer",
              "minimum": 0
            },
            "lots": {
              "type": "integer",
              "minimum": 0
            },
            "reused": {
              "type": "integer",
              "minimum": 0
            },
            "days": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "charge backend totale [mini, probable, maxi] après réemploi, en jours"
            },
            "abaques": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "calibrated": {
              "type": "boolean",
              "description": "section backend fournie par l'utilisateur ou la mission"
            },
            "errors": {
              "type": "array",
