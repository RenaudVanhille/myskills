      },
      "report": {
        "format": "json",
        "description": "Ressources, opérations, événements, intégrations, lots, lots en réemploi, charge totale à trois points après réemploi, abaques lus et s'ils sont fournis.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "outputs",
            "resources",
            "operations",
            "events",
            "integrations",
            "lots",
            "reused",
            "days",
            "abaques",
            "calibrated",
            "errors",
            "warnings"
          ],
          "properties": {
            "input": {
              "type": "string"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "integer",
              "minimum": 0
            },
            "operations": {
