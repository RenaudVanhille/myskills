{
  "skill": "api-contract",
  "level": "moyen",
  "inputs": [
    "Description JSON courte des interfaces (api_build.py --schema) : ressources, opérations REST, événements",
    "Facultatif : exigences.json (requirements-catalog) et options.json avec l'option retenue (architecture-options)"
  ],
  "outputs": [
    "<nom>.openapi.yaml : contrat OpenAPI 3.1 des opérations REST",
    "<nom>.asyncapi.yaml : contrat AsyncAPI 3.0 des événements",
    "<nom>.api.md : tableaux des opérations, événements et ressources, couverture des exigences"
  ],
  "scripts": [
    {
      "name": "api_build.py",
      "role": "Écrit les contrats OpenAPI 3.1 et AsyncAPI 3.0 d'une description courte et les contrôle : noms uniques, une opération par méthode et chemin, types et ressources connus, champs obligatoires déclarés, pas de corps pour GET et DELETE, exigences citées présentes, composant porteur présent dans l'option, exigence fonctionnelle indispensable sans interface et écriture sans sécurité signalées ; relit chaque YAML écrit et résout chaque $ref.",
      "usage": "uv run scripts/api_build.py API.json [--out-dir DOSSIER] | --schema",
      "options": {
        "API.json": "description des interfaces",
        "--out-dir": "dossier des fichiers produits (défaut : celui du .json)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
      "exit_codes": {
        "0": "contrats écrits et relus (avertissements possibles : exigence sans interface, écriture sans sécurité, ressource inutilisée)",
        "1": "description invalide, type ou ressource inconnus, doublon, exigence ou composant absents, relecture en échec ; aucun fichier produit sauf en cas d'échec de relecture"
      },
      "input": {
        "format": "json",
        "description": "Description des interfaces.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "resources"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "servers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "security": {
              "enum": [
                "oauth2",
                "oidc",
                "bearer",
                "apikey",
                "none"
              ],
              "description": "schéma de sécurité de toute l'API (défaut : none)"
            },
            "requirements": {
              "type": "string",
              "description": "chemin d'exigences.json (requirements-catalog), relatif à la description"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "options",
                "option"
              ],
              "description": "option d'architecture dont les composants portent les interfaces",
              "properties": {
                "options": {
                  "type": "string",
                  "minLength": 1
                },
                "option": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "fields"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Za-z0-9]*$"
                  },
                  "description": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "champ -> type : string, integer, number, boolean, date, date-time, uuid, email, uri, binary, une ressource, ou X[]"
                  },
                  "required": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "enums": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "method",
                  "path",
                  "summary"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]*$"
                  },
                  "method": {
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "request": {
                    "type": "string",
                    "minLength": 1
                  },
                  "response": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 599
                    }
                  },
                  "query": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "component": {
                    "type": "string",
                    "description": "composant de l'option qui porte l'opération"
                  },
                  "public": {
                    "type": "boolean",
                    "description": "sans authentification, par choix"
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "exigences portées (identifiants d'exigences.json)"
                  }
                }
              }
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "channel",
                  "payload"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Za-z0-9]*$"
                  },
                  "channel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "payload": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "enum": [
                      "send",
                      "receive"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  },
                  "component": {
                    "type": "string"
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "exigences portées (identifiants d'exigences.json)"
                  }
                }
              }
            }
          },
          "description": "Au moins une opération (operations) ou un événement (events)."
        }
      },
      "report": {
        "format": "json",
        "description": "Fichiers écrits, compteurs, couverture des exigences.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "outputs",
            "operations",
            "events",
            "resources",
            "covered",
            "uncovered",
            "errors",
            "warnings"
          ],
          "properties": {
            "input": {
              "type": "string"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "operations": {
              "type": "integer",
              "minimum": 0
            },
            "events": {
              "type": "integer",
              "minimum": 0
            },
            "resources": {
              "type": "integer",
              "minimum": 0
            },
            "covered": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "exigences portées par au moins une interface"
            },
            "uncovered": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "exigences fonctionnelles indispensables sans interface"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "requires": [
    {
      "skill": "requirements-catalog",
      "script": "req_build.py",
      "why": "valider exigences.json contre son schéma",
      "optional": true
    },
    {
      "skill": "architecture-options",
      "script": "options_build.py",
      "why": "valider options.json et reprendre les composants de l'option",
      "optional": true
    }
  ],
  "handoffs": [
    {
      "to": "architecture-review",
      "kind": "skill",
      "when": "les interfaces doivent être revues avec l'architecture (traçabilité, dépendances synchrones)"
    },
    {
      "to": "document-publisher",
      "kind": "agent",
      "when": "les contrats doivent être livrés dans un dossier Word, HTML ou XWiki"
    },
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "une exigence fonctionnelle indispensable n'a pas d'interface : l'ajouter ou dire qu'elle est hors API"
    }
  ]
}
