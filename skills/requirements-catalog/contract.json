{
  "skill": "requirements-catalog",
  "level": "moyen",
  "inputs": [
    "Documents en Markdown (sortie de doc-to-markdown) dans un dossier sources",
    "Description JSON des exigences : title, sources, requirements (id repris des documents ou EF-/ENF-, nature, title, text, priority, category ou domain, metric, sources avec citation, questions, status), ignored, glossary (terme, définition, synonymes)"
  ],
  "outputs": [
    "<nom>.md : catalogue pour la revue (exigences fonctionnelles, non fonctionnelles, questions, exigences déduites, retirées, phrases écartées, glossaire avec les exigences qui emploient chaque terme)",
    "<nom>.csv : même catalogue pour un tableur (séparateur ;, UTF-8 avec BOM)"
  ],
  "scripts": [
    {
      "name": "req_build.py",
      "role": "Vérifie chaque citation dans son document et en donne la ligne, repère les phrases normatives des sources reprises par aucune exigence (avec --laya, les phrases d'exigence selon le modèle local Laya, et ses désaccords sur la nature et la catégorie), signale une exigence renumérotée alors que sa source porte un identifiant, doublons et exigences non mesurables, puis écrit le catalogue en Markdown et en CSV.",
      "usage": "uv run scripts/req_build.py exigences.json [--out-dir DOSSIER] [--laya [--laya-cache FICHIER]] | --schema",
      "options": {
        "exigences.json": "description des exigences ; le dossier sources est relatif à ce fichier",
        "--out-dir": "dossier des fichiers produits (défaut : celui du .json)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête",
        "--laya": "phrases d'exigence, nature et catégorie contrôlées par le modèle local Laya (req_laya.py), avertissements seulement ; repli sur la regex sans Laya",
        "--laya-cache": "cache des réponses de Laya (défaut : .myskills-tmp/<nom>.laya.json à côté du .json) ; implique --laya"
      },
      "input": {
        "format": "json",
        "description": "Validée avant tout traitement : clé inconnue, type, valeur hors liste, identifiant mal formé ou champ manquant donnent une erreur avec son chemin ; les clés qui commencent par _ sont des commentaires.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "requirements"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "sources": {
              "type": "string",
              "minLength": 1,
              "description": "Dossier des documents Markdown, relatif au .json (défaut : sources)."
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "text",
                  "priority"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9]*([-_.][A-Za-z0-9]+)*$",
                    "description": "Identifiant des documents s'ils numérotent déjà leurs exigences (REQ-012...), sinon EF-001 fonctionnelle, ENF-001 non fonctionnelle ; stable d'une version à l'autre."
                  },
                  "nature": {
                    "enum": [
                      "fonctionnelle",
                      "non-fonctionnelle"
                    ],
                    "description": "Obligatoire si l'identifiant ne commence pas par EF- ou ENF-."
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "priority": {
                    "enum": [
                      "indispensable",
                      "importante",
                      "souhaitable",
                      "hors-perimetre"
                    ]
                  },
                  "domain": {
                    "type": "string",
                    "description": "Domaine fonctionnel (exigence fonctionnelle)."
                  },
                  "category": {
                    "enum": [
                      "performance",
                      "disponibilite",
                      "securite",
                      "conformite",
                      "exploitabilite",
                      "maintenabilite",
                      "evolutivite",
                      "interoperabilite",
                      "utilisabilite",
                      "portabilite",
                      "cout",
                      "autre"
                    ]
                  },
                  "metric": {
                    "type": "string",
                    "description": "Mesure vérifiable (exigence non fonctionnelle)."
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "doc"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "doc": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Chemin du Markdown, relatif au dossier sources."
                        },
                        "quote": {
                          "type": "string",
                          "description": "Citation exacte, retrouvée par le script."
                        },
                        "page": {
                          "type": [
                            "integer",
                            "string"
                          ]
                        }
                      }
                    }
                  },
                  "derived": {
                    "type": "string",
                    "description": "Exigence sans citation : d'où elle est déduite."
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "status": {
                    "enum": [
                      "retenue",
                      "retiree"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Raison du retrait."
                  }
                }
              }
            },
            "ignored": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "doc",
                  "quote",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "doc": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "glossary": {
              "type": "array",
              "description": "Glossaire du projet : termes métier et sigles employés par les exigences.",
              "items": {
                "type": "object",
                "required": [
                  "term",
                  "definition"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Synonymes, sigle ou forme développée."
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "doc"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "doc": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Chemin du Markdown, relatif au dossier sources."
                        },
                        "quote": {
                          "type": "string",
                          "description": "Citation exacte, retrouvée par le script."
                        },
                        "page": {
                          "type": [
                            "integer",
                            "string"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Compteurs, fichiers produits, méthode (regles ou laya), phrases normatives que Laya ne tient pas pour des exigences (dismissed), désaccords de Laya (disagreements), erreurs (citation introuvable, document absent, identifiant en double) et avertissements (phrase d'exigence non reprise, exigence non mesurable, doublon, désaccord de Laya).",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "outputs",
                "functional",
                "non_functional",
                "retired",
                "ignored",
                "questions",
                "documents",
                "uncovered",
                "errors",
                "warnings",
                "glossary",
                "method",
                "dismissed",
                "disagreements"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "non_functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "retired": {
                  "type": "integer",
                  "minimum": 0
                },
                "ignored": {
                  "type": "integer",
                  "minimum": 0
                },
                "questions": {
                  "type": "integer",
                  "minimum": 0
                },
                "documents": {
                  "type": "integer",
                  "minimum": 0
                },
                "uncovered": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "glossary": {
                  "type": "integer",
                  "minimum": 0
                },
                "method": {
                  "type": "string",
                  "pattern": "^(regles|laya.*)$"
                },
                "dismissed": {
                  "type": "integer",
                  "minimum": 0
                },
                "disagreements": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "catalogue produit sans erreur (avertissements possibles)",
        "1": "description invalide, citation introuvable ou autre erreur ; aucun fichier produit"
      }
    },
    {
      "name": "req_laya.py",
      "role": "Pose au modèle local Laya les questions fermées de req_build.py --laya (la phrase est-elle une exigence, sa nature, sa catégorie) ; lancé par req_build.py dans son propre environnement.",
      "usage": "uv run scripts/req_laya.py questions.json | --schema",
      "options": {
        "questions.json": "questions écrites par req_build.py --laya",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
      "input": {
        "format": "json",
        "description": "Validée avant le chargement du modèle : clé inconnue, question hors liste ou texte vide donnent une erreur avec son chemin.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "question",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question": {
                    "enum": [
                      "exigence",
                      "nature",
                      "categorie"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Méthode (modèle Laya employé) et réponse à chaque question : probabilité pour exigence, choix et confiance pour nature et categorie ; erreur si la description est invalide ou si Laya ne se charge pas.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "input",
            "method",
            "answers",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "string"
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "answers": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "probability"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "probability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "choice",
                      "confidence"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "choice": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                ]
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "toutes les questions posées (une phrase sans réponse est un avertissement)",
        "1": "description invalide ou Laya indisponible"
      }
    }
  ],
  "handoffs": [
    {
      "to": "doc-to-markdown",
      "kind": "skill",
      "when": "les documents ne sont pas encore en Markdown"
    },
    {
      "to": "architecture-options",
      "kind": "skill",
      "when": "le catalogue est validé : proposer des architectures"
    },
    {
      "to": "decision-log",
      "kind": "skill",
      "when": "noter les choix (exigence déduite, phrase écartée, priorité) et soumettre le catalogue à la revue"
    }
  ]
}
