{
  "skill": "requirements-catalog",
  "level": "moyen",
  "inputs": [
    "Documents en Markdown (sortie de doc-to-markdown) dans un dossier sources",
    "Description JSON des exigences : title, sources, requirements (id repris des documents ou EF-/ENF-, nature, title, text, priority, category ou domain, metric, sources avec citation, questions, status), ignored, glossary (terme, définition, synonymes)"
  ],
  "outputs": [
    "<nom>.md : catalogue pour la revue (exigences fonctionnelles, non fonctionnelles, questions, exigences déduites, retirées, phrases écartées, glossaire avec les exigences qui emploient chaque terme)",
    "<nom>.csv : même catalogue pour un tableur (séparateur ;, UTF-8 avec BOM)",
    "ecarts-exigences.md : écart entre le catalogue validé et sa copie de travail d'une évolution (req_diff.py)"
  ],
  "scripts": [
    {
      "name": "req_build.py",
      "role": "Vérifie chaque citation dans son document et en donne la ligne, repère les phrases des sources reprises par aucune exigence (phrases normatives par la regex ; avec --candidates et son tri par un modèle léger, les phrases qu'il tient pour des exigences ; avec --laya, celles du modèle local Laya et ses désaccords sur la catégorie), signale une exigence renumérotée alors que sa source porte un identifiant, doublons et exigences non mesurables, puis écrit le catalogue en Markdown et en CSV ; avec --draft, écrit d'abord le brouillon de la description (une exigence par phrase normative des sources, citation exacte, identifiant du document, nature, catégorie, priorité et mesure déduites) que le modèle trie.",
      "usage": "uv run scripts/req_build.py exigences.json [--out-dir DOSSIER] [--candidates [FICHIER]] [--triage FICHIER] [--laya [--laya-cache FICHIER]] | exigences.json --draft [--sources DOSSIER] | --schema",
      "options": {
        "exigences.json": "description des exigences ; le dossier sources est relatif à ce fichier",
        "--out-dir": "dossier des fichiers produits (défaut : celui du .json)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête",
        "--laya": "phrases d'exigence et catégorie contrôlées par le modèle local Laya (req_laya.py), avertissements seulement ; repli sur la regex sans Laya",
        "--laya-cache": "cache des réponses de Laya (défaut : .myskills-tmp/<nom>.laya.json à côté du .json) ; implique --laya",
        "--candidates": "écrit les phrases non reprises, avec la consigne de tri, pour un sous-agent de niveau simple (défaut : <nom>.candidats.json à côté du .json)",
        "--triage": "tri de ces phrases, objet JSON clé -> true (exigence) ou false, validé (défaut : <nom>.tri.json à côté du .json, lu s'il existe) ; il décide seul pour les phrases triées",
        "--draft": "écrire le brouillon de la description, sans réécrire un fichier existant : une exigence par phrase normative des sources, à trier",
        "--sources": "avec --draft : dossier des sources, relatif au .json (défaut : sources)"
      },
      "input": {
        "format": "json",
        "description": "Validée avant tout traitement : clé inconnue, type, valeur hors liste, identifiant mal formé ou champ manquant donnent une erreur avec son chemin ; les clés qui commencent par _ sont des commentaires.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "requirements"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "sources": {
              "type": "string",
              "minLength": 1,
              "description": "Dossier des documents Markdown, relatif au .json (défaut : sources)."
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "text",
                  "priority"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9]*([-_.][A-Za-z0-9]+)*$",
                    "description": "Identifiant des documents s'ils numérotent déjà leurs exigences (REQ-012...), sinon EF-001 fonctionnelle, ENF-001 non fonctionnelle ; stable d'une version à l'autre."
                  },
                  "nature": {
                    "enum": [
                      "fonctionnelle",
                      "non-fonctionnelle"
                    ],
                    "description": "Obligatoire si l'identifiant ne commence pas par EF- ou ENF-."
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "priority": {
                    "enum": [
                      "indispensable",
                      "importante",
                      "souhaitable",
                      "hors-perimetre"
                    ]
                  },
                  "domain": {
                    "type": "string",
                    "description": "Domaine fonctionnel (exigence fonctionnelle)."
                  },
                  "category": {
                    "enum": [
                      "performance",
                      "disponibilite",
                      "securite",
                      "conformite",
                      "exploitabilite",
                      "maintenabilite",
                      "evolutivite",
                      "interoperabilite",
                      "utilisabilite",
                      "portabilite",
                      "cout",
                      "autre"
                    ]
                  },
                  "metric": {
                    "type": "string",
                    "description": "Mesure vérifiable (exigence non fonctionnelle)."
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "doc"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "doc": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Chemin du Markdown, relatif au dossier sources."
                        },
                        "quote": {
                          "type": "string",
                          "description": "Citation exacte, retrouvée par le script."
                        },
                        "page": {
                          "type": [
                            "integer",
                            "string"
                          ]
                        }
                      }
                    }
                  },
                  "derived": {
                    "type": "string",
                    "description": "Exigence sans citation : d'où elle est déduite."
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "status": {
                    "enum": [
                      "retenue",
                      "retiree"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Raison du retrait."
                  }
                }
              }
            },
            "ignored": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "doc",
                  "quote",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "doc": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "glossary": {
              "type": "array",
              "description": "Glossaire du projet : termes métier et sigles employés par les exigences.",
              "items": {
                "type": "object",
                "required": [
                  "term",
                  "definition"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Synonymes, sigle ou forme développée."
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "doc"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "doc": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Chemin du Markdown, relatif au dossier sources."
                        },
                        "quote": {
                          "type": "string",
                          "description": "Citation exacte, retrouvée par le script."
                        },
                        "page": {
                          "type": [
                            "integer",
                            "string"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Compteurs, fichiers produits, méthode (regles, tri, laya), phrases que la regex ou Laya signaleraient et que le tri écarte ou que Laya ne tient pas pour des exigences (dismissed), désaccords de Laya sur la catégorie (disagreements), phrases écrites pour le tri (candidates), erreurs (citation introuvable, document absent, identifiant en double, tri invalide) et avertissements (phrase d'exigence non reprise, exigence non mesurable, doublon, désaccord de Laya).",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "outputs",
                "functional",
                "non_functional",
                "retired",
                "ignored",
                "questions",
                "documents",
                "uncovered",
                "errors",
                "warnings",
                "glossary",
                "method",
                "dismissed",
                "disagreements",
                "candidates"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "non_functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "retired": {
                  "type": "integer",
                  "minimum": 0
                },
                "ignored": {
                  "type": "integer",
                  "minimum": 0
                },
                "questions": {
                  "type": "integer",
                  "minimum": 0
                },
                "documents": {
                  "type": "integer",
                  "minimum": 0
                },
                "uncovered": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "glossary": {
                  "type": "integer",
                  "minimum": 0
                },
                "method": {
                  "type": "string",
                  "pattern": "^(regles|laya.*|tri.*)$"
                },
                "dismissed": {
                  "type": "integer",
                  "minimum": 0
                },
                "disagreements": {
                  "type": "integer",
                  "minimum": 0
                },
                "candidates": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input",
                "outputs",
                "requirements",
                "functional",
                "non_functional",
                "documents",
                "errors",
                "warnings"
              ],
              "description": "Avec --draft : brouillon écrit.",
              "properties": {
                "input": {
                  "type": "string"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requirements": {
                  "type": "integer",
                  "minimum": 0
                },
                "functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "non_functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "documents": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "catalogue produit sans erreur (avertissements possibles)",
        "1": "description invalide, citation introuvable ou autre erreur ; aucun fichier produit"
      }
    },
    {
      "name": "req_laya.py",
      "role": "Pose au modèle local Laya les questions fermées de req_build.py --laya (la phrase est-elle une exigence, quelle catégorie) ; lancé par req_build.py dans son propre environnement.",
      "usage": "uv run scripts/req_laya.py questions.json | --schema",
      "options": {
        "questions.json": "questions écrites par req_build.py --laya",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
      "input": {
        "format": "json",
        "description": "Validée avant le chargement du modèle : clé inconnue, question hors liste ou texte vide donnent une erreur avec son chemin.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "question",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question": {
                    "enum": [
                      "exigence",
                      "categorie"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Méthode (modèle Laya employé) et réponse à chaque question : probabilité pour exigence, choix et confiance pour categorie ; erreur si la description est invalide ou si Laya ne se charge pas.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "input",
            "method",
            "answers",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "string"
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "answers": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "probability"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "probability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "choice",
                      "confidence"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "choice": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                ]
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "toutes les questions posées (une phrase sans réponse est un avertissement)",
        "1": "description invalide ou Laya indisponible"
      }
    },
    {
      "name": "req_diff.py",
      "role": "Compare le catalogue validé et sa copie de travail d'une évolution : exigences ajoutées, retirées (absentes ou sorties du périmètre retenu) et modifiées champ par champ (texte, priorité, mesure, catégorie, nature, domaine, titre), exigence ajoutée sans source signalée ; avec --domains, contextes bornés qui portent chaque exigence changée et exigence ajoutée sans contexte ; avec --start, copie la référence dans la copie de travail ; les deux catalogues sont validés contre le schéma de req_build.py.",
      "usage": "uv run scripts/req_diff.py REFERENCE.json COPIE.json [--schema] [--start] [--domains domaines.json] [--out ecarts.md]",
      "options": {
        "REFERENCE.json": "catalogue validé (exigences.json de référence)",
        "COPIE.json": "copie de travail qui reçoit les changements",
        "--start": "copie la référence dans COPIE.json si elle manque, avec les documents cités par ses exigences (dans le dossier sources de la copie), puis s'arrête",
        "--domains": "domaines.json (domain-design) : contextes bornés qui portent les exigences changées",
        "--out": "écart en Markdown (ajoutées, modifiées, retirées)",
        "--schema": "affiche le schéma JSON des descriptions comparées sur une ligne, puis s'arrête"
      },
      "report": {
        "format": "json",
        "description": "Exigences ajoutées, retirées, modifiées, changements champ par champ et contextes touchés.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "copy",
            "output",
            "added",
            "removed",
            "modified",
            "changes",
            "contexts",
            "copied_sources",
            "errors",
            "warnings"
          ],
          "properties": {
            "reference": {
              "type": "string"
            },
            "copy": {
              "type": "string"
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "modified": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "field",
                  "before",
                  "after"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "before": {},
                  "after": {}
                }
              }
            },
            "contexts": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": "exigence changée -> contextes qui la portent (avec --domains)"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "copied_sources": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "avec --start : documents cités par la référence copiés dans les sources de la copie"
            }
          }
        }
      },
      "exit_codes": {
        "0": "écart calculé (et écrit avec --out), ou copie de travail créée avec --start",
        "1": "catalogue illisible ou non conforme au schéma de req_build.py, ou domaines.json invalide"
      },
      "input": {
        "format": "json",
        "description": "Deux catalogues d'exigences au format de req_build.py (référence et copie de travail), validés avant tout travail ; domaines.json (--domains) validé contre le schéma de domain_build.py.",
        "same_as": "requirements-catalog/req_build.py",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "requirements"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "sources": {
              "type": "string",
              "minLength": 1,
              "description": "Dossier des documents Markdown, relatif au .json (défaut : sources)."
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
