{
  "skill": "requirements-catalog",
  "level": "moyen",
  "inputs": [
    "Documents en Markdown (sortie de doc-to-markdown) dans un dossier sources",
    "Description JSON des exigences : title, sources, requirements (id repris des documents ou EF-001 / SECU-01, PERF-01... par catégorie, nature, title, text, priority, category ou domain, metric, sources avec citation, questions, status), ignored, glossary (terme, définition, synonymes)"
  ],
  "outputs": [
    "<nom>.md : catalogue pour la revue (exigences fonctionnelles, non fonctionnelles, questions, exigences déduites, retirées, phrases écartées, glossaire avec les exigences qui emploient chaque terme) ; chaque source est un lien Markdown vers le document, à la section de la ligne citée",
    "<nom>.csv : même catalogue pour un tableur (séparateur ;, UTF-8 avec BOM)",
    "ecarts-exigences.md : écart entre le catalogue validé et sa copie de travail d'une évolution (req_diff.py)"
  ],
  "scripts": [
    {
      "name": "req_build.py",
      "role": "Vérifie chaque citation dans son document et en donne la ligne, repère les phrases des sources reprises par aucune exigence (phrases normatives par la regex ; avec --candidates et son tri par un modèle léger, les phrases qu'il tient pour des exigences), signale une exigence renumérotée alors que sa source porte un identifiant, doublons, exigences non mesurables et dimensions de volumétrie absentes (utilisateurs, pic, débit, données, croissance, conservation), puis écrit le catalogue en Markdown et en CSV ; avec --draft, écrit d'abord le brouillon de la description (une exigence par phrase normative des sources, citation exacte, identifiant du document, nature, catégorie, priorité et mesure déduites) que le modèle trie.",
      "usage": "uv run scripts/req_build.py exigences.json [--out-dir DOSSIER] [--candidates [FICHIER]] [--triage FICHIER] | exigences.json --draft [--sources DOSSIER] | --schema",
      "options": {
        "exigences.json": "description des exigences ; le dossier sources est relatif à ce fichier",
        "--out-dir": "dossier des fichiers produits (défaut : celui du .json)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête",
        "--candidates": "écrit les phrases non reprises, avec la consigne de tri, pour un sous-agent de niveau simple (défaut : <nom>.candidats.json à côté du .json)",
        "--triage": "tri de ces phrases, objet JSON clé -> true (exigence) ou false, validé (défaut : <nom>.tri.json à côté du .json, lu s'il existe) ; il décide seul pour les phrases triées",
        "--draft": "écrire le brouillon de la description, sans réécrire un fichier existant : une exigence par phrase normative des sources, à trier",
        "--sources": "avec --draft : dossier des sources, relatif au .json (défaut : sources)"
      },
      "input": {
        "format": "json",
        "description": "Validée avant tout traitement : clé inconnue, type, valeur hors liste, identifiant mal formé ou champ manquant donnent une erreur avec son chemin ; les clés qui commencent par _ sont des commentaires.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "requirements"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "sources": {
              "type": "string",
              "minLength": 1,
              "description": "Dossier des documents Markdown, relatif au .json (défaut : sources)."
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "text",
                  "priority"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9]*([-_.][A-Za-z0-9]+)*$",
                    "description": "Identifiant des documents s'ils numérotent déjà leurs exigences (REQ-012...), sinon EF-001 fonctionnelle, préfixe de catégorie pour une non fonctionnelle (SECU-01 sécurité, PERF-01 performance, DISP, CONF, EXPL, MAIN, EVOL, INTE, UTIL, PORT, COUT ; ENF-01 autre) ; stable d'une version à l'autre."
                  },
                  "nature": {
                    "enum": [
                      "fonctionnelle",
                      "non-fonctionnelle"
                    ],
                    "description": "Obligatoire si l'identifiant n'est pas une numérotation du catalogue (EF-001, SECU-01, PERF-01...)."
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "priority": {
                    "enum": [
                      "indispensable",
                      "importante",
                      "souhaitable",
                      "hors-perimetre"
                    ]
                  },
                  "domain": {
                    "type": "string",
                    "description": "Domaine fonctionnel (exigence fonctionnelle)."
                  },
                  "category": {
                    "enum": [
                      "performance",
                      "disponibilite",
                      "securite",
                      "conformite",
                      "exploitabilite",
                      "maintenabilite",
                      "evolutivite",
                      "interoperabilite",
                      "utilisabilite",
                      "portabilite",
                      "cout",
                      "autre"
                    ]
                  },
                  "metric": {
                    "type": "string",
                    "description": "Mesure vérifiable (exigence non fonctionnelle)."
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "doc"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "doc": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Chemin du Markdown, relatif au dossier sources."
                        },
                        "quote": {
                          "type": "string",
                          "description": "Citation exacte, retrouvée par le script."
                        },
                        "page": {
                          "type": [
                            "integer",
                            "string"
                          ]
                        }
                      }
                    }
                  },
                  "derived": {
                    "type": "string",
                    "description": "Exigence sans citation : d'où elle est déduite."
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "status": {
                    "enum": [
                      "retenue",
                      "retiree"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Raison du retrait."
                  }
                }
              }
            },
            "ignored": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "doc",
                  "quote",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "doc": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "glossary": {
              "type": "array",
              "description": "Glossaire du projet : termes métier et sigles employés par les exigences.",
              "items": {
                "type": "object",
                "required": [
                  "term",
                  "definition"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Synonymes, sigle ou forme développée."
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "doc"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "doc": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Chemin du Markdown, relatif au dossier sources."
                        },
                        "quote": {
                          "type": "string",
                          "description": "Citation exacte, retrouvée par le script."
                        },
                        "page": {
                          "type": [
                            "integer",
                            "string"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "volumetry": {
              "type": "object",
              "additionalProperties": false,
              "description": "Dimensions de volumétrie sans objet pour ce projet, avec leur raison (ex. retention : aucune donnée conservée). Une dimension ni couverte par une exigence ou une question, ni déclarée ici, est signalée.",
              "properties": {
                "utilisateurs": {
                  "type": "string",
                  "minLength": 1
                },
                "pointe": {
                  "type": "string",
                  "minLength": 1
                },
                "debit": {
                  "type": "string",
                  "minLength": 1
                },
                "donnees": {
                  "type": "string",
                  "minLength": 1
                },
                "croissance": {
                  "type": "string",
                  "minLength": 1
                },
                "retention": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "renamed": {
              "type": "object",
              "description": "Correspondance ancien -> nouvel identifiant, écrite par journal.py upgrade quand il renumérote par catégorie les ENF- d'un catalogue déjà produit (ENF-004 -> SECU-01) ; le catalogue la reprend, les autres workflows de la mission la suivent.",
              "additionalProperties": false,
              "patternProperties": {
                "^ENF-\\d{3}$": {
                  "type": "string",
                  "pattern": "^[A-Z]+-\\d{2,3}$"
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Compteurs, fichiers produits, méthode (regles, tri), phrases normatives que le tri écarte (dismissed), phrases écrites pour le tri (candidates), erreurs (citation introuvable, document absent, identifiant en double, tri invalide) et avertissements (phrase d'exigence non reprise, exigence non mesurable, doublon, volumétrie absente) ; volumetry_missing : dimensions de volumétrie à demander.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "outputs",
                "functional",
                "non_functional",
                "retired",
                "ignored",
                "questions",
                "documents",
                "uncovered",
                "errors",
                "warnings",
                "glossary",
                "method",
                "dismissed",
                "candidates",
                "volumetry_missing"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "non_functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "retired": {
                  "type": "integer",
                  "minimum": 0
                },
                "ignored": {
                  "type": "integer",
                  "minimum": 0
                },
                "questions": {
                  "type": "integer",
                  "minimum": 0
                },
                "documents": {
                  "type": "integer",
                  "minimum": 0
                },
                "uncovered": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "glossary": {
                  "type": "integer",
                  "minimum": 0
                },
                "method": {
                  "type": "string",
                  "pattern": "^(regles|tri)$"
                },
                "dismissed": {
                  "type": "integer",
                  "minimum": 0
                },
                "candidates": {
                  "type": "integer",
                  "minimum": 0
                },
                "volumetry_missing": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "utilisateurs",
                      "pointe",
                      "debit",
                      "donnees",
                      "croissance",
                      "retention"
                    ]
                  },
                  "description": "Dimensions de volumétrie absentes : ni exigence, ni question, ni sans objet."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input",
                "outputs",
                "requirements",
                "functional",
                "non_functional",
                "documents",
                "errors",
                "warnings"
              ],
              "description": "Avec --draft : brouillon écrit.",
              "properties": {
                "input": {
                  "type": "string"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requirements": {
                  "type": "integer",
                  "minimum": 0
                },
                "functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "non_functional": {
                  "type": "integer",
                  "minimum": 0
                },
                "documents": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "catalogue produit sans erreur (avertissements possibles)",
        "1": "description invalide, citation introuvable ou autre erreur ; aucun fichier produit"
      }
    },
    {
      "name": "req_diff.py",
      "role": "Compare le catalogue validé et sa copie de travail d'une évolution : exigences ajoutées, retirées (absentes ou sorties du périmètre retenu) et modifiées champ par champ (texte, priorité, mesure, catégorie, nature, domaine, titre), exigence ajoutée sans source signalée ; avec --domains, contextes bornés qui portent chaque exigence changée et exigence ajoutée sans contexte ; avec --start, copie la référence dans la copie de travail ; les deux catalogues sont validés contre le schéma de req_build.py.",
      "usage": "uv run scripts/req_diff.py REFERENCE.json COPIE.json [--schema] [--start] [--domains domaines.json] [--out ecarts.md]",
      "options": {
        "REFERENCE.json": "catalogue validé (exigences.json de référence)",
        "COPIE.json": "copie de travail qui reçoit les changements",
        "--start": "copie la référence dans COPIE.json si elle manque, avec les documents cités par ses exigences (dans le dossier sources de la copie), puis s'arrête",
        "--domains": "domaines.json (domain-design) : contextes bornés qui portent les exigences changées",
        "--out": "écart en Markdown (ajoutées, modifiées, retirées)",
        "--schema": "affiche le schéma JSON des descriptions comparées sur une ligne, puis s'arrête"
      },
      "report": {
        "format": "json",
        "description": "Exigences ajoutées, retirées, modifiées, changements champ par champ et contextes touchés.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "copy",
            "output",
            "added",
            "removed",
            "modified",
            "changes",
            "contexts",
            "copied_sources",
            "errors",
            "warnings"
          ],
          "properties": {
