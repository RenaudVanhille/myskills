{
  "skill": "domain-design",
  "level": "complexe",
  "inputs": [
    "Les exigences (exigences.json de requirements-catalog) et, sur un existant, le modèle de données actuel (modele.json de data-model)",
    "Description JSON du découpage (domain_build.py --schema) : sous-domaines, contextes bornés (entités, exigences, équipe, langage, besoins propres), carte des contextes, facteurs de la grille de style"
  ],
  "outputs": [
    "<nom>.md : style recommandé et grille, sous-domaines, contextes et leur langage, carte des contextes, couplage, points d'attention",
    "<nom>.styles.json : composants et flux du monolithe modulaire, du mixte et des microservices, au format d'options.json",
    "<nom>.carte.drawio : carte des contextes (une colonne par sous-domaine), et son image avec --export"
  ],
  "scripts": [
    {
      "name": "domain_build.py",
      "role": "Vérifie sous-domaines, contextes, exigences et entités citées, un seul contexte propriétaire par entité ; calcule cohésion et couplage entre contextes, signale dépendance absente de la carte, cycle, noyau partagé, exigence fonctionnelle sans contexte ; calcule le style recommandé (monolithe modulaire, mixte, microservices) et les contextes à extraire avec la grille ; écrit le document, les squelettes de composants vérifiés contre le schéma d'options.json et la carte des contextes contrôlée par drawio_build.py.",
      "usage": "uv run scripts/domain_build.py DOMAINES.json [--out-dir DOSSIER] [--export png|svg] [--vault VAULT --folder DOSSIER_DU_VAULT] | --schema",
      "options": {
        "DOMAINES.json": "description du découpage",
        "--out-dir": "dossier des fichiers produits (défaut : celui de la description)",
        "--export": "exporter aussi la carte des contextes en image (diagram-export)",
        "--vault": "vault Obsidian où écrire aussi une note decoupage-domaines et une note contexte-borne par contexte, selon son ontologie",
        "--folder": "dossier des notes dans le vault, celui du workflow (Workflows/<titre>) ; avec --vault",
        "--schema": "affiche le schéma de la description sur une ligne"
      },
      "input": {
        "format": "json",
        "description": "Découpage décrit par le modèle ; validé avant tout traitement.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "required": [
            "title",
            "subdomains",
            "contexts"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            },
            "context": {
              "type": "string",
              "maxLength": 600,
              "description": "Objet du découpage, repris dans le document."
            },
            "requirements": {
              "type": "string",
              "minLength": 1,
              "description": "exigences.json (requirements-catalog), relatif à la description"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "description d'un modèle de données existant (data-model, modele.json), relative à la description : entités et relations pour la propriété et le couplage. Sur un projet neuf, le découpage vient d'abord et le modèle de chaque contexte ensuite (data-model, champ context) : sans modèle, le couplage se calcule sur les entités possédées et utilisées"
            },
            "subdomains": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "kind"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "coeur",
                      "support",
                      "generique"
                    ],
                    "description": "coeur : différenciant, développé et confié aux meilleurs ; support : nécessaire, spécifique ; generique : à acheter ou réutiliser"
                  },
                  "why": {
                    "type": "string",
                    "maxLength": 300
                  }
                }
              }
            },
            "contexts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "subdomain"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subdomain": {
                    "type": "string",
                    "description": "identifiant du sous-domaine"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "team": {
                    "type": "string",
                    "minLength": 1,
                    "description": "équipe qui le développe et l'exploite"
                  },
                  "entities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Za-z0-9]*$"
                    },
                    "description": "entités possédées (noms du modèle de données) : un seul contexte propriétaire par entité"
                  },
                  "uses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Za-z0-9]*$"
                    },
                    "description": "entités d'un autre contexte qu'il lit (par son API ou ses événements)"
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9]*([-_.][A-Za-z0-9]+)*$"
                    },
                    "description": "exigences portées par le contexte"
                  },
                  "terms": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 300
                    },
                    "description": "langage du contexte : terme -> sens dans ce contexte"
                  },
                  "needs": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "besoins propres au contexte, plus forts que ceux des autres, chacun avec sa raison",
                    "properties": {
                      "echelle": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 300
                      },
                      "cadence": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 300
                      },
                      "isolation": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 300
                      },
                      "technologie": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 300
                      }
                    }
                  }
                }
              }
            },
            "relations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "upstream",
                  "downstream",
                  "patterns"
                ],
                "properties": {
                  "upstream": {
                    "type": "string",
                    "description": "contexte amont (fournisseur)"
                  },
                  "downstream": {
                    "type": "string",
                    "description": "contexte aval, qui dépend de l'amont"
                  },
                  "patterns": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": [
                        "partenariat",
                        "client-fournisseur",
                        "conformiste",
                        "acl",
                        "open-host",
                        "langage-publie",
                        "noyau-partage",
                        "chemins-separes"
                      ]
                    },
                    "description": "motifs de la carte des contextes"
                  },
                  "integration": {
                    "enum": [
                      "sync",
                      "async"
                    ],
                    "description": "appel synchrone de l'aval vers l'amont, ou événements de l'amont (défaut : sync)"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            },
            "factors": {
              "type": "object",
              "additionalProperties": false,
              "description": "facteurs de la grille de style, chacun avec sa valeur et sa raison",
              "properties": {
                "devops": {
                  "type": "object",
                  "required": [
                    "value",
                    "why"
                  ],
                  "additionalProperties": false,
                  "description": "maturité intégration et déploiement continus, conteneurs, observabilité, astreinte",
                  "properties": {
                    "value": {
                      "enum": [
                        "faible",
                        "moyenne",
                        "forte"
                      ]
                    },
                    "why": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 300
                    }
                  }
                },
                "stabilite": {
                  "type": "object",
                  "required": [
                    "value",
                    "why"
                  ],
                  "additionalProperties": false,
                  "description": "frontières du domaine connues et stables",
                  "properties": {
                    "value": {
                      "enum": [
                        "incertaine",
                        "connue"
                      ]
                    },
                    "why": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 300
                    }
                  }
                },
                "coherence": {
                  "type": "object",
                  "required": [
                    "value",
                    "why"
                  ],
                  "additionalProperties": false,
                  "description": "cohérence transactionnelle exigée entre contextes",
                  "properties": {
                    "value": {
                      "enum": [
                        "forte",
                        "eventuelle"
                      ]
                    },
                    "why": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 300
                    }
                  }
                },
                "delai": {
                  "type": "object",
                  "required": [
                    "value",
                    "why"
                  ],
                  "additionalProperties": false,
                  "description": "délai de mise en production",
                  "properties": {
                    "value": {
                      "enum": [
                        "court",
                        "normal"
                      ]
                    },
                    "why": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 300
                    }
                  }
                }
              }
            },
            "decision": {
              "type": "object",
              "required": [
                "style",
                "why"
              ],
              "additionalProperties": false,
              "description": "style retenu par l'utilisateur, après la revue",
              "properties": {
                "style": {
                  "enum": [
                    "monolithe-modulaire",
                    "mixte",
                    "microservices"
                  ]
                },
                "why": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 300
                },
                "extract": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "contextes extraits en services (mixte)"
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Fichiers écrits, compteurs, couplage et style recommandé.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "outputs",
            "subdomains",
            "contexts",
            "relations",
            "coupling",
            "style",
            "vault",
            "errors",
            "warnings"
          ],
          "properties": {
            "input": {
              "type": "string"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "subdomains": {
              "type": "integer",
              "minimum": 0
            },
            "contexts": {
              "type": "integer",
              "minimum": 0
            },
            "relations": {
              "type": "integer",
              "minimum": 0
            },
            "coupling": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "relations",
                "cross",
                "ratio",
                "basis"
              ],
              "description": "liens de données (relations du modèle et entités utilisées ; sans modèle, entités possédées et utilisées) : total, entre contextes, part, base du calcul",
              "properties": {
                "relations": {
                  "type": "integer",
                  "minimum": 0
                },
                "cross": {
                  "type": "integer",
                  "minimum": 0
                },
                "ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "basis": {
                  "enum": [
                    "modele",
                    "contextes"
                  ],
                  "description": "base du calcul : relations du modèle de données (modele), ou entités possédées et utilisées sans modèle (contextes)"
                }
              }
            },
            "style": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "recommended",
                "score",
                "extract",
                "confidence",
                "missing"
              ],
              "properties": {
                "recommended": {
                  "enum": [
                    "monolithe-modulaire",
                    "mixte",
                    "microservices"
                  ]
                },
                "score": {
                  "type": "integer"
                },
                "extract": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "contextes à extraire en services (mixte)"
                },
                "confidence": {
                  "enum": [
                    "faible",
                    "moyenne",
                    "bonne"
                  ]
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "facteurs non renseignés"
                }
              }
            },
            "vault": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "vault",
                    "folder",
                    "notes",
                    "removed"
                  ],
                  "properties": {
                    "vault": {
                      "type": "string"
                    },
                    "folder": {
                      "type": "string"
                    },
                    "notes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "removed": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "document, squelettes et carte écrits (avertissements possibles : dépendance hors carte, cycle, entité sans contexte, grille incomplète)",
        "1": "description invalide, identifiant en double, sous-domaine, contexte, exigence ou entité inconnus, entité possédée par deux contextes ; aucun fichier produit"
      }
    }
  ],
  "requires": [
    {
      "skill": "requirements-catalog",
      "script": "req_build.py",
      "why": "valider exigences.json contre son schéma",
      "optional": true
    },
    {
      "skill": "data-model",
      "script": "model_build.py",
      "why": "valider la description du modèle de données (entités, relations)",
      "optional": true
    },
    {
      "skill": "architecture-options",
      "script": "options_build.py",
      "why": "vérifier les squelettes de composants de chaque style contre le schéma d'options.json",
      "optional": true
    },
    {
      "skill": "drawio-diagram",
      "script": "drawio_build.py",
      "why": "dessiner et contrôler la carte des contextes",
      "optional": true
    },
    {
      "skill": "markdown-to-obsidian",
      "script": "lib/vault_ontology.py",
      "why": "ontologie du vault Obsidian (source unique) : construire et vérifier les notes écrites"
    },
    {
      "skill": "mission-workspace",
      "script": "lib/workspace.py",
      "why": "espace de travail de la mission (mission.json, vault et dossiers par défaut)"
    }
  ],
  "handoffs": [
    {
      "to": "data-model",
      "kind": "skill",
      "when": "découpage validé : modèle de données de chaque contexte (champ context des entités, schéma par contexte, clé étrangère entre contextes signalée)"
    },
    {
      "to": "architecture-options",
      "kind": "skill",
      "when": "options à comparer : partir des squelettes de <nom>.styles.json (style recommandé et une alternative)"
    },
    {
      "to": "api-contract",
      "kind": "skill",
      "when": "contrats des relations de la carte (API de l'amont, événements publiés)"
    },
    {
      "to": "architecture-review",
      "kind": "skill",
      "when": "contrôler une architecture contre le découpage (domains, règles DOM-)"
    },
    {
      "to": "diagram-export",
      "kind": "skill",
      "when": "image de la carte demandée après coup"
    },
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "facteur de la grille inconnu (équipes, maturité DevOps, cohérence exigée) : la question à poser, une seule fois"
    }
  ],
  "vault": {
    "writes": [
      "decoupage-domaines",
      "contexte-borne"
    ],
    "reads": false
  }
}
