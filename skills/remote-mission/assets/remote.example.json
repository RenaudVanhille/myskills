{
  "missions": {
    "portail-sinistres": {
      "repo": "https://gitlab.exemple.local/archi/portail-sinistres.git",
      "base": "main",
      "title": "Mission portail sinistres",
      "web": "https://gitlab.exemple.local/archi/portail-sinistres"
    }
  },
  "workdir": "/work",
  "branch_prefix": "openwebui/",
  "allowed_hosts": [
    "gitlab.exemple.local",
    "litellm.litellm.svc.cluster.local"
  ],
  "access": {
    "provider": "gitlab",
    "api": "https://gitlab.exemple.local/api/v4",
    "token_env": "GITLAB_ACCESS_TOKEN",
    "read_level": 20,
    "write_level": 30
  },
  "agent": {
    "command": [
      "claude",
      "-p",
      "{prompt}",
      "--output-format",
      "text",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Bash(uv run:*)",
      "Bash(python:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill",
      "Agent"
    ],
    "timeout": 5400,
    "env": {
      "ANTHROPIC_BASE_URL": "http://litellm.litellm.svc.cluster.local:4000",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "DISABLE_AUTOUPDATER": "1"
    }
  },
  "git": {
    "name": "myskills-remote",
    "email": "myskills-remote@exemple.local"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8765,
    "token_env": "MYSKILLS_REMOTE_TOKEN",
    "max_jobs": 4
  },
  "runner": {
    "kind": "kubernetes",
    "image": "registry.exemple.local/myskills/remote-mission:2.4.0",
    "secret": "myskills-turn",
    "git_secret": "myskills-git",
    "config_map": "myskills-remote",
    "ttl_seconds": 900,
    "resources": {
      "requests": {
        "cpu": "500m",
        "memory": "1Gi"
      },
      "limits": {
        "memory": "4Gi"
      }
    }
  }
}
