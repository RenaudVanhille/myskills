{
  "skill": "markdown-to-obsidian",
  "level": "simple",
  "inputs": [
    "Notes Markdown (sortie de doc-to-markdown ou existantes)",
    "Dossier du vault Obsidian (facultatif)"
  ],
  "outputs": [
    "Note au format Obsidian, sur place ou dans VAULT/<dossier>/",
    "Images dans le dossier de pièces jointes du vault",
    "Avec --move : rien ne reste dans le dossier de travail",
    "Avec vault_check.py --graph : graphe typé des notes (JSON node-link NetworkX)"
  ],
  "scripts": [
    {
      "name": "obsidianize.py",
      "role": "Met des notes au format Obsidian et les range dans le vault.",
      "usage": "uv run scripts/obsidianize.py NOTE.md [...] [--vault DOSSIER] [--folder SOUS-DOSSIER] [--attachments attachments] [--source NOM] [--tags a,b] [--move] [--classify [--domains a,b]]",
      "options": {
        "NOTE.md": "notes à transformer",
        "--vault": "vault de destination",
        "--folder": "sous-dossier du vault",
        "--attachments": "dossier des pièces jointes (défaut attachments)",
        "--source": "document d'origine, pour le frontmatter",
        "--tags": "tags séparés par des virgules",
        "--move": "avec --vault : supprime la note et les images d'origine",
        "--classify": "ajoute nature et domaine au frontmatter (Laya)",
        "--domains": "avec --classify : domaines possibles"
      },
      "report": {
        "format": "json",
        "description": "Objet : results (un objet par fichier, une ligne chacun), errors et warnings. Un objet par note.",
        "schema": {
          "type": "object",
          "required": [
            "results",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "results": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "output",
                      "embeds",
                      "wikilinks",
                      "callouts",
                      "attachments_copied",
                      "missing"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "output": {
                        "type": "string"
                      },
                      "embeds": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "wikilinks": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "callouts": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "attachments_copied": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "missing": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "classification": {
                        "type": "object",
                        "required": [
                          "type",
                          "domaine",
                          "method",
                          "warnings"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "domaine": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "method": {
                            "type": "string"
                          },
                          "warnings": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "classification_warning": {
                        "type": "string"
                      },
                      "validation": {
                        "type": "object",
                        "required": [
                          "ok",
                          "errors",
                          "warnings"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "ok": {
                            "type": "boolean"
                          },
                          "errors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "warnings": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "input",
                      "error"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Une ligne par fichier en échec, plus les erreurs du lot."
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Avertissements du lot (ceux d'un fichier sont dans son résultat)."
            }
          }
        }
      },
      "exit_codes": {
        "0": "toutes les notes sont traitées",
        "1": "une note est introuvable ou une image manque (missing)"
      }
    },
    {
      "name": "vault_profile.py",
      "role": "Lit le vault (lecture seule) : tags, dossiers, dossier des pièces jointes.",
      "usage": "uv run scripts/vault_profile.py VAULT [--top 50]",
      "options": {
        "VAULT": "racine du vault",
        "--top": "nombre de tags listés (défaut 50)"
      },
      "report": {
        "format": "json",
        "description": "Un objet ; tags donne le nombre de notes par tag.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "vault",
                "notes",
                "tags",
                "folders",
                "attachments",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "vault": {
                  "type": "string"
                },
                "notes": {
                  "type": "integer",
                  "minimum": 0
                },
                "tags": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "folders": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "notes",
                      "top_tags"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "notes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "top_tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "attachments": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "vault",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "vault": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "profil produit",
        "1": "vault introuvable"
      }
    },
    {
      "name": "vault_check.py",
      "role": "Vérifie les notes typées du vault contre l'ontologie (scripts/lib/vault-ontology.json), relit la lisibilité des notes générées et exporte leur graphe typé (lecture seule, sauf --style et --templates).",
      "usage": "uv run scripts/vault_check.py VAULT [--folder DOSSIER] [--graph graphe.json] [--strict] [--style] [--templates [DOSSIER]] | --ontology [TYPE]",
      "options": {
        "VAULT": "racine du vault",
        "--folder": "ne vérifier que ce dossier du vault (liens résolus dans tout le vault)",
        "--graph": "écrit le graphe des notes au format node-link de NetworkX (nodes ; links avec relation, lien pour un wikilink du corps)",
        "--strict": "code de sortie 1 aussi sur un avertissement",
        "--ontology": "affiche l'ontologie résumée (ou celle d'un type) sur une ligne et s'arrête",
        "--style": "à la demande de l'utilisateur seulement : écrit les couleurs des types (champ color de l'ontologie) dans .obsidian/graph.json (groupes de couleurs par tag type/<type>, autres réglages gardés) et l'extrait CSS .obsidian/snippets/myskills-types.css, activé dans appearance.json",
        "--templates": "à la demande de l'utilisateur seulement : écrit un modèle de note par type de l'ontologie dans DOSSIER (défaut Modèles, réglé dans .obsidian/templates.json et activé dans core-plugins.json s'il existe ; modèle de l'utilisateur au même nom gardé) et le type Obsidian de chaque propriété dans .obsidian/types.json (types réglés par l'utilisateur gardés) ; le dossier des modèles n'est pas vérifié"
      },
      "report": {
        "format": "json",
        "description": "Compteurs par type ; results ne liste que les notes en erreur ou en avertissement. Avec --ontology : l'ontologie résumée.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "vault",
                "notes",
                "typed",
                "untyped",
                "types",
                "relations",
                "graph",
                "results",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "vault": {
                  "type": "string"
                },
                "notes": {
                  "type": "integer",
                  "minimum": 0
                },
                "typed": {
                  "type": "integer",
                  "minimum": 0
                },
                "untyped": {
                  "type": "integer",
                  "minimum": 0
                },
                "types": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "relations": {
                  "type": "integer",
                  "minimum": 0
                },
                "graph": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "file",
                        "nodes",
                        "links"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "nodes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "links": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  ]
                },
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "note",
                      "type",
                      "errors",
                      "warnings"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "note": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "errors": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "style": {
                  "type": "object",
                  "required": [
                    "graph",
                    "groups",
                    "kept",
                    "snippet"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "graph": {
                      "type": "string"
                    },
                    "groups": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "kept": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "snippet": {
                      "type": "string"
                    }
                  }
                },
                "templates": {
                  "type": "object",
                  "description": "avec --templates : modèles écrits et réglages",
                  "required": [
                    "folder",
                    "templates",
                    "kept",
                    "properties",
                    "plugin"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "folder": {
                      "type": "string"
                    },
                    "templates": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "kept": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "modèles de l'utilisateur au même nom, non écrasés"
                    },
                    "properties": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "propriétés typées dans types.json"
                    },
                    "plugin": {
                      "type": "boolean",
                      "description": "plugin cœur Modèles activé (core-plugins.json présent)"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "version",
                "common",
                "tags",
                "types",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "integer"
                },
                "common": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tags": {
                  "type": "string"
                },
                "types": {
                  "type": "object"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "vault": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "notes conformes (ou ontologie affichée)",
        "1": "vault introuvable, type inconnu, ou note hors ontologie (avec --strict : aussi un avertissement)"
      }
    }
  ],
  "vault": {
    "writes": [
      "document"
    ],
    "reads": true
  },
  "handoffs": [
    {
      "to": "doc-to-markdown",
      "kind": "skill",
      "when": "valider la note avec validate.py --obsidian"
    },
    {
      "to": "markdown-publish",
      "kind": "skill",
      "when": "exporter la note en Word, HTML ou XWiki"
    }
  ],
  "requires": [
    {
      "skill": "doc-to-markdown",
      "script": "classify.py",
      "why": "classer les documents avant la conversion (--classify)",
      "optional": true
    },
    {
      "skill": "doc-to-markdown",
      "script": "validate.py",
      "why": "valider les notes produites",
      "optional": true
    },
    {
      "skill": "mission-workspace",
      "script": "lib/workspace.py",
      "why": "espace de travail de la mission (mission.json, vault et dossiers par défaut)"
    }
  ]
}
