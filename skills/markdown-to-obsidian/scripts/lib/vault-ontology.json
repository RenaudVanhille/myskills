  "canvas": {"columns": [["workflow"], ["exigence"], ["option-architecture", "adr"], ["revue-architecture", "revue-well-architected", "modele-menaces", "chiffrage", "decoupage-domaines"], ["constat", "risque", "menace"]], "max": 30, "skip_relations": ["workflow"]},
