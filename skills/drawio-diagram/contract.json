{
  "skill": "drawio-diagram",
  "inputs": [
    "Décision de diagram-brief et description JSON du schéma : title, audience, elements (ou pages)",
    "Ou un .drawio existant à modifier"
  ],
  "outputs": [
    "<sujet>.drawio en XML clair, à côté de sa description <sujet>.json",
    "Après export : <sujet>.drawio.png, .svg ou .pdf"
  ],
  "scripts": [
    {
      "name": "drawio_build.py",
      "role": "Construit le .drawio aux styles de la charte à partir de la description JSON, puis le vérifie comme check_drawio.py.",
      "usage": "uv run scripts/drawio_build.py SUJET.json [--out SUJET.drawio] | --schema",
      "options": {
        "SUJET.json": "description du schéma (même format que excalidraw_build.py, plus pages)",
        "--out": "fichier .drawio (défaut : même nom)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
      "input": {
        "format": "json",
        "description": "Validée avant tout traitement : clé inconnue, type, valeur hors liste ou champ manquant donnent une erreur avec son chemin ; les clés qui commencent par _ sont des commentaires.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "audience": {
              "enum": [
                "technique",
                "non technique"
              ]
            },
            "legend": {
              "enum": [
                "auto",
                true,
                false
              ]
            },
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/element"
              }
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "legend": {
                    "enum": [
                      "auto",
                      true,
                      false
                    ]
                  },
                  "elements": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/element"
                    }
                  }
                }
              }
            }
          },
          "$defs": {
            "element": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "style": {
                      "enum": [
                        "sync",
                        "async"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "role": {
                      "enum": [
                        "person",
                        "system",
                        "external",
                        "db",
                        "queue",
                        "alert",
                        "zone",
                        "note"
                      ]
                    },
                    "shape": {
                      "enum": [
                        "rectangle",
                        "ellipse",
                        "diamond"
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "row": {
                      "type": "number"
                    },
                    "col": {
                      "type": "number"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "minimum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 1
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Un objet ; si la description est illisible, seulement input et errors.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "output",
                "pages",
                "shapes",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "output": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pages": {
                  "type": "integer",
                  "minimum": 0
                },
                "shapes": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "schéma produit sans erreur",
        "1": "description illisible ou erreur"
      }
    },
    {
      "name": "check_drawio.py",
      "role": "Vérifie un fichier draw.io avant export.",
      "usage": "uv run scripts/check_drawio.py SCHEMA.drawio [...]",
      "report": {
        "format": "json",
        "description": "Un objet par fichier.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "pages",
              "shapes",
              "errors",
              "warnings"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "pages": {
                "type": "integer",
                "minimum": 0
              },
              "shapes": {
                "type": "integer",
                "minimum": 0
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "aucune erreur",
        "1": "au moins un fichier a une erreur"
      }
    }
  ],
  "handoffs": [
    {
      "to": "diagram-export",
      "kind": "skill",
      "when": "exporter et relire l'image"
    }
  ]
}
