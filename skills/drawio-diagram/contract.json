{
  "skill": "drawio-diagram",
  "level": "moyen",
  "inputs": [
    "Décision de diagram-brief et description JSON du schéma : title, audience, elements (ou pages)",
    "Ou un .drawio existant à modifier"
  ],
  "outputs": [
    "<sujet>.drawio en XML clair, à côté de sa description <sujet>.json",
    "Après export : <sujet>.drawio.png, .svg ou .pdf",
    "Depuis un .drawio existant : sa description courte <sujet>.json (drawio_read.py), à éditer puis reconstruire"
  ],
  "scripts": [
    {
      "name": "drawio_build.py",
      "role": "Construit le .drawio aux styles de la charte à partir de la description JSON, puis le vérifie comme check_drawio.py.",
      "usage": "uv run scripts/drawio_build.py SUJET.json [--out SUJET.drawio] [--export png|svg] | --schema",
      "options": {
        "SUJET.json": "description du schéma (même format que excalidraw_build.py, plus pages)",
        "--out": "fichier .drawio (défaut : même nom)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête",
        "--export": "exporte aussi l'image (diagram-export) dans le même appel : rapport export, une erreur si l'export échoue"
      },
      "input": {
        "format": "json",
        "description": "Validée avant tout traitement : clé inconnue, type, valeur hors liste ou champ manquant donnent une erreur avec son chemin ; les clés qui commencent par _ sont des commentaires.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "audience": {
              "enum": [
                "technique",
                "non technique"
              ]
            },
            "legend": {
              "enum": [
                "auto",
                true,
                false
              ]
            },
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/element"
              }
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "legend": {
                    "enum": [
                      "auto",
                      true,
                      false
                    ]
                  },
                  "elements": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/element"
                    }
                  }
                }
              }
            }
          },
          "$defs": {
            "element": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "style": {
                      "enum": [
                        "sync",
                        "async"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "role": {
                      "enum": [
                        "person",
                        "system",
                        "external",
                        "db",
                        "queue",
                        "alert",
                        "zone",
                        "note"
                      ]
                    },
                    "shape": {
                      "enum": [
                        "rectangle",
                        "ellipse",
                        "diamond"
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "row": {
                      "type": "number"
                    },
                    "col": {
                      "type": "number"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "minimum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 1
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Un objet ; si la description est illisible, seulement input et errors.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "output",
                "pages",
                "shapes",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "output": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pages": {
                  "type": "integer",
                  "minimum": 0
                },
                "shapes": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "export": {
                  "type": "object",
                  "required": [
                    "outputs",
                    "warnings"
                  ],
                  "additionalProperties": false,
                  "description": "Avec --export : images écrites par diagram-export et ses avertissements (image vide ou trop petite).",
                  "properties": {
                    "outputs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "review_image": {
                  "type": "boolean",
                  "description": "Lisibilité douteuse selon check_drawio.py : ouvrir l'image exportée ; sinon, ne pas l'ouvrir."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "schéma produit sans erreur",
        "1": "description illisible ou erreur"
      }
    },
    {
      "name": "check_drawio.py",
      "role": "Vérifie un fichier draw.io avant export : structure, charte, chevauchements, et lisibilité estimée sans rendu (libellé trop long pour sa forme, flèches qui se croisent, flèche sous une forme) ; dit s'il faut relire l'image exportée (review_image).",
      "usage": "uv run scripts/check_drawio.py SCHEMA.drawio [...]",
      "report": {
        "format": "json",
        "description": "Objet : results (un objet par fichier, une ligne chacun), errors et warnings. Un objet par fichier.",
        "schema": {
          "type": "object",
          "required": [
            "results",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "results": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "pages",
                  "shapes",
                  "review_image",
                  "errors",
                  "warnings"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "pages": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "shapes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "warnings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "review_image": {
                    "type": "boolean",
                    "description": "Lisibilité douteuse (avertissement de lisibilité ou chevauchement) : ouvrir l'image exportée ; sinon, ne pas l'ouvrir."
                  }
                }
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Une ligne par fichier en échec, plus les erreurs du lot."
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Avertissements du lot (ceux d'un fichier sont dans son résultat)."
            }
          }
        }
      },
      "exit_codes": {
        "0": "aucune erreur",
        "1": "au moins un fichier a une erreur"
      }
    },
    {
      "name": "drawio_read.py",
      "role": "Tire d'un .drawio existant (XML clair ou compressé) la description JSON courte de drawio_build.py : rôle de chaque forme déduit de son style, identifiants, libellés sans HTML et positions (ou grille approchée), flèches avec libellé et style ; vérifie la description contre le schéma de drawio_build.py avant de l'écrire. Le modèle édite cette description au lieu du XML.",
      "usage": "uv run scripts/drawio_read.py SCHEMA.drawio [--out SCHEMA.json] [--grid] [--force]",
      "options": {
        "SCHEMA.drawio": "schéma draw.io à reprendre",
        "--out": "description JSON (défaut : SCHEMA.json à côté du .drawio)",
        "--grid": "grille approchée (row, col) au lieu des coordonnées : drawio_build.py refait la mise en page",
        "--force": "remplacer une description existante"
      },
      "report": {
        "format": "json",
        "description": "Pages, formes et flèches lues, description écrite ; avertissements : flèche sans extrémité, forme sans libellé, icônes de fournisseur.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "input",
            "output",
            "pages",
            "elements",
            "arrows",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "string"
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "pages": {
              "type": "integer",
              "minimum": 0
            },
            "elements": {
              "type": "integer",
              "minimum": 0,
              "description": "formes lues (zones et notes comprises)"
            },
            "arrows": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "description écrite",
        "1": "fichier illisible, schéma vide, description existante sans --force ou non conforme"
      }
    }
  ],
  "requires": [
    {
      "skill": "diagram-export",
      "script": "export.py",
      "why": "--export : rendre l'image dans le même appel que la construction",
      "optional": true
    }
  ],
  "handoffs": [
    {
      "to": "diagram-export",
      "kind": "skill",
      "when": "exporter et relire l'image"
    }
  ]
}
