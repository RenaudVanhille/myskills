{
  "skill": "excalidraw-diagram",
  "inputs": [
    "Décision de diagram-brief",
    "Description JSON du schéma : title, audience, elements"
  ],
  "outputs": [
    "<sujet>.excalidraw, à côté de sa description <sujet>.json",
    "Après export : <sujet>.excalidraw.png ou .svg"
  ],
  "scripts": [
    {
      "name": "excalidraw_build.py",
      "role": "Construit la scène Excalidraw à partir de la description JSON.",
      "usage": "uv run scripts/excalidraw_build.py SCHEMA.json [--out SCHEMA.excalidraw] | --schema",
      "options": {
        "SCHEMA.json": "description du schéma",
        "--out": "fichier produit (défaut : même nom)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
      "input": {
        "format": "json",
        "description": "Validée avant tout traitement : clé inconnue, type, valeur hors liste ou champ manquant donnent une erreur avec son chemin ; les clés qui commencent par _ sont des commentaires.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "audience": {
              "enum": [
                "technique",
                "non technique"
              ]
            },
            "legend": {
              "enum": [
                "auto",
                true,
                false
              ]
            },
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/element"
              }
            },
            "font": {
              "enum": [
                "excalifont",
                "nunito",
                "helvetica"
              ]
            }
          },
          "$defs": {
            "element": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "style": {
                      "enum": [
                        "sync",
                        "async"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "role": {
                      "enum": [
                        "person",
                        "system",
                        "external",
                        "db",
                        "queue",
                        "alert",
                        "zone",
                        "note"
                      ]
                    },
                    "shape": {
                      "enum": [
                        "rectangle",
                        "ellipse",
                        "diamond"
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "row": {
                      "type": "number"
                    },
                    "col": {
                      "type": "number"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "minimum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 1
                    },
                    "fontSize": {
                      "type": "integer",
                      "minimum": 8
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Un objet ; si la description est illisible, seulement input et errors.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "output",
                "elements",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "output": {
                  "type": "string"
                },
                "elements": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "scène produite sans erreur",
        "1": "description illisible ou erreur"
      }
    }
  ],
  "handoffs": [
    {
      "to": "diagram-export",
      "kind": "skill",
      "when": "rendre et relire l'image"
    }
  ]
}
