{
  "_doc": "Cible Bootstrap de page_build.py : classes des composants remplacées par celles de Bootstrap, feuille de style à version fixée (local_tools.PACKAGES), thème tiré des tokens. Une classe absente garde le style de mockup-to-html.",
  "package": "bootstrap",
  "provides": ["button", "buttons", "card", "table", "badge", "alert", "form", "breadcrumb", "list", "divider"],
  "classes": {
    "c-button": "btn",
    "c-button--primary": "btn-primary",
    "c-button--secondary": "btn-secondary",
    "c-button--outline": "btn-outline-primary",
    "c-button--ghost": "btn-link",
    "c-button--danger": "btn-danger",
    "c-button--sm": "btn-sm",
    "c-button--lg": "btn-lg",
    "c-buttons": "d-flex flex-wrap gap-2",
    "c-card": "card h-100",
    "c-card__body": "card-body",
    "c-card__title": "card-title h5",
    "c-table": "table",
    "c-table--striped": "table-striped",
    "c-table--plain": "",
    "c-badge": "badge rounded-pill",
    "c-badge--neutral": "text-bg-light",
    "c-badge--info": "text-bg-info",
    "c-badge--success": "text-bg-success",
    "c-badge--warning": "text-bg-warning",
    "c-badge--danger": "text-bg-danger",
    "c-alert": "alert",
    "c-alert--info": "alert-info",
    "c-alert--success": "alert-success",
    "c-alert--warning": "alert-warning",
    "c-alert--danger": "alert-danger",
    "c-input": "form-control",
    "c-select": "form-select",
    "c-check": "form-check-input",
    "c-field": "mb-0",
    "c-text--muted": "text-body-secondary",
    "c-text--bold": "fw-bold",
    "c-divider": "my-0",
    "c-list--plain": "list-unstyled",
    "c-list--check": "list-unstyled"
  },
  "css": [
    ":root{--bs-primary:var(--color-primary);--bs-secondary:var(--color-secondary);--bs-body-font-family:var(--font-body);--bs-body-font-size:var(--text-md);--bs-body-line-height:var(--line-height);--bs-body-color:var(--color-text);--bs-body-bg:var(--color-background);--bs-secondary-color:var(--color-muted);--bs-border-color:var(--color-border);--bs-border-radius:var(--radius-md);--bs-border-radius-lg:var(--radius-lg);--bs-link-color:var(--color-primary);--bs-link-hover-color:var(--color-primary);--bs-heading-color:inherit}",
    ".btn-primary{--bs-btn-bg:var(--color-primary);--bs-btn-border-color:var(--color-primary);--bs-btn-color:var(--color-on-primary);--bs-btn-hover-bg:color-mix(in srgb,var(--color-primary) 85%,black);--bs-btn-hover-border-color:var(--bs-btn-hover-bg);--bs-btn-hover-color:var(--color-on-primary);--bs-btn-active-bg:var(--bs-btn-hover-bg)}",
    ".btn-secondary{--bs-btn-bg:var(--color-secondary);--bs-btn-border-color:var(--color-secondary);--bs-btn-color:var(--color-on-secondary);--bs-btn-hover-bg:color-mix(in srgb,var(--color-secondary) 85%,black);--bs-btn-hover-border-color:var(--bs-btn-hover-bg);--bs-btn-hover-color:var(--color-on-secondary)}",
    ".btn-danger{--bs-btn-bg:var(--color-danger);--bs-btn-border-color:var(--color-danger);--bs-btn-color:var(--color-on-danger)}",
    ".btn-outline-primary{--bs-btn-color:var(--color-primary);--bs-btn-border-color:var(--color-primary);--bs-btn-hover-bg:var(--color-primary);--bs-btn-hover-color:var(--color-on-primary)}",
    ".btn-link{--bs-btn-color:var(--color-primary)}",
    ".btn{font-weight:600}",
    ".c-section h1,.c-section h2,.c-section h3{color:inherit}"
  ]
}
