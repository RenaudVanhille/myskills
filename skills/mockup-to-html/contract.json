{
  "skill": "mockup-to-html",
  "level": "moyen",
  "inputs": [
    "Maquettes d'écrans en image (PNG, JPEG, WebP), par exemple tirées d'un appel d'offres par doc-to-markdown",
    "Description JSON de chaque page (page_build.py --schema) : arbre de composants, textes, tokens",
    "Facultatif : tokens du design system (design-system, ds_build.py --schema)"
  ],
  "outputs": [
    "<nom>.html : page sémantique (header, nav, main, section, footer), accessible, responsive",
    "<nom>.css : variables CSS des tokens puis styles des composants",
    "assets/ : zones découpées dans la maquette (logos, photos, illustrations)",
    "<nom>.render.png : rendu de la page ; <nom>.compare.png : maquette, rendu et écarts côte à côte"
  ],
  "scripts": [
    {
      "name": "page_build.py",
      "role": "Écrit le HTML sémantique et le CSS d'une page décrite par un arbre de composants (27 : section, row, grid, header, card, form, table, tabs, stepper...), contrôle composants, propriétés, variantes, tokens, images locales et zones découpées, accessibilité (h1 unique, niveaux de titres, textes alternatifs, contraste par section) ; rend la page dans un navigateur local réseau coupé, la compare à la maquette (similarité, zones les plus éloignées, hauteur) et contrôle le débordement sur mobile.",
      "usage": "uv run scripts/page_build.py PAGE.json [--out-dir DOSSIER] [--no-render] [--min-similarity 0.6] | --schema",
      "options": {
        "PAGE.json": "description de la page",
        "--out-dir": "dossier des fichiers produits (défaut : celui du .json)",
        "--no-render": "sans rendu ni comparaison (page non vérifiée, signalé)",
        "--min-similarity": "similarité en dessous de laquelle la page est signalée (défaut 0.6)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
      "exit_codes": {
        "0": "page écrite (avertissements possibles : similarité faible, accessibilité, rendu non vérifié faute de navigateur)",
        "1": "description ou tokens invalides, composant, propriété, variante ou token inconnu, ressource externe, zone hors maquette, design-system absent ; aucun fichier produit"
      },
      "input": {
        "format": "json",
        "description": "Page décrite en arbre de composants, avec sa maquette et ses tokens.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "body"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "lang": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
              "description": "défaut fr"
            },
            "mockup": {
              "type": "string",
              "minLength": 1,
              "description": "image de la maquette, relative à la description : rendu comparé, zones découpées (crop)"
            },
            "scale": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 4,
              "description": "pixels de la maquette par pixel CSS (2 pour un export retina ; défaut 1)"
            },
            "width": {
              "type": "integer",
              "minimum": 320,
              "maximum": 3840,
              "description": "largeur de rendu en pixels CSS (défaut : celle de la maquette, sinon 1280)"
            },
            "max_width": {
              "type": "integer",
              "minimum": 320,
              "maximum": 3840,
              "description": "largeur du contenu, remplace celle des tokens"
            },
            "tokens": {
              "type": "string",
              "minLength": 1,
              "description": "fichier de tokens du design system (ds_build.py --schema), relatif à la description ; défaut : tokens par défaut"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              },
              "minItems": 1
            }
          },
          "$defs": {
            "node": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "section",
                    "row",
                    "stack",
                    "grid",
                    "header",
                    "nav",
                    "breadcrumb",
                    "heading",
                    "text",
                    "link",
                    "button",
                    "buttons",
                    "image",
                    "box",
                    "card",
                    "form",
                    "table",
                    "list",
                    "badge",
                    "alert",
                    "tabs",
                    "stepper",
                    "stat",
                    "search",
                    "divider",
                    "spacer",
                    "footer"
                  ]
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][\\w-]*$"
                },
                "text": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "size": {
                  "type": "string",
                  "minLength": 1,
                  "description": "heading, text : token font_sizes ; spacer : token spacing ; button : sm, md, lg"
                },
                "variant": {
                  "type": "string",
                  "description": "button : primary, secondary, outline, ghost, danger ; nav : horizontal, vertical ; table : plain, striped ; list : bullet, ordered, check, plain ; badge, alert : info, success, warning, danger (badge : neutral)"
                },
                "muted": {
                  "type": "boolean"
                },
                "bold": {
                  "type": "boolean"
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "valign": {
                  "enum": [
                    "start",
                    "center",
                    "end",
                    "stretch"
                  ]
                },
                "background": {
                  "type": "string",
                  "minLength": 1,
                  "description": "token de couleur (ou #rrggbb, signalé hors design system)"
                },
                "color": {
                  "type": "string",
                  "minLength": 1,
                  "description": "token de couleur du texte ; défaut on-<background> s'il existe"
                },
                "padding": {
                  "type": "string",
                  "minLength": 1,
                  "description": "token spacing"
                },
                "gap": {
                  "type": "string",
                  "minLength": 1,
                  "description": "token spacing"
                },
                "radius": {
                  "type": "string",
                  "minLength": 1,
                  "description": "token radii"
                },
                "shadow": {
                  "type": "string",
                  "minLength": 1,
                  "description": "token shadows"
                },
                "width": {
                  "anyOf": [
                    {
                      "enum": [
                        "full",
                        "contained"
                      ]
                    },
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3840
                    }
                  ],
                  "description": "section : full ou contained (défaut) ; box : px"
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4000,
                  "description": "image, box : px"
                },
                "columns": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "minItems": 1,
                      "maxItems": 12
                    }
                  ],
                  "description": "row : proportions [2, 1] ; grid : nombre de colonnes ; form : 1 ou 2"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/node"
                  }
                },
                "items": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "text"
                        ],
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "href": {
                            "type": "string"
                          },
                          "active": {
                            "type": "boolean"
                          },
                          "variant": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "minItems": 1
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "text"
                        ],
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "href": {
                            "type": "string"
                          },
                          "active": {
                            "type": "boolean"
                          },
                          "variant": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "minItems": 1
                },
                "current": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "tabs, stepper : rang de l'élément actif, à partir de 1"
                },
                "src": {
                  "type": "string",
                  "minLength": 1,
                  "description": "image locale, relative à la description (aucune URL)"
                },
                "crop": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "zone [x, y, largeur, hauteur] de la maquette, en pixels de l'image"
                },
                "alt": {
                  "type": "string",
                  "description": "texte alternatif ; \"\" pour une image décorative"
                },
                "href": {
                  "type": "string"
                },
                "placeholder": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "enum": [
                          "text",
                          "email",
                          "password",
                          "number",
                          "tel",
                          "date",
                          "search",
                          "url",
                          "file",
                          "select",
                          "textarea",
                          "checkbox",
                          "radio"
                        ]
                      },
                      "placeholder": {
                        "type": "string"
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "help": {
                        "type": "string"
                      },
                      "width": {
                        "enum": [
                          "half",
                          "full"
                        ]
                      }
                    }
                  },
                  "minItems": 1
                },
                "submit": {
                  "type": "string"
                },
                "headers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "title",
                      "items"
                    ],
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "text"
                              ],
                              "properties": {
                                "text": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "href": {
                                  "type": "string"
                                },
                                "active": {
                                  "type": "boolean"
                                },
                                "variant": {
                                  "type": "string"
                                }
                              }
                            }
                          ]
                        },
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Fichiers, composants, rendu, similarité avec la maquette et zones à reprendre.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "outputs",
            "components",
            "tokens",
            "rendered",
            "similarity",
            "height_ratio",
            "zones",
            "mobile_overflow",
            "blocked",
            "errors",
            "warnings"
          ],
          "properties": {
            "input": {
              "type": "string"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "components": {
              "type": "integer",
              "minimum": 0
            },
            "tokens": {
              "type": [
                "string",
                "null"
              ]
            },
            "rendered": {
              "type": "boolean"
            },
            "similarity": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "height_ratio": {
              "type": [
                "number",
                "null"
              ]
            },
            "zones": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height",
                  "similarity"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  },
                  "similarity": {
                    "type": "number"
                  }
                }
              }
            },
            "mobile_overflow": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "blocked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "requires": [
    {
      "skill": "design-system",
      "script": "ds_build.py",
      "why": "tokens : schéma, valeurs par défaut, couleurs dérivées, variables CSS et contraste"
    }
  ],
  "handoffs": [
    {
      "to": "design-system",
      "kind": "skill",
      "when": "les tokens (couleurs, typographie, espacements) ne sont pas encore définis : ds_extract.py --draft depuis les maquettes"
    },
    {
      "to": "document-extractor",
      "kind": "agent",
      "when": "les maquettes sont dans un PDF, un PowerPoint ou un Word : en extraire les images"
    },
    {
      "to": "document-publisher",
      "kind": "agent",
      "when": "les pages doivent être livrées dans un document Word ou un site XWiki"
    },
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "une maquette est ambiguë (état d'un écran, contenu masqué, interaction) : la question à poser"
    }
  ]
}
