{
  "skill": "check-prerequisites",
  "inputs": [
    "Un groupe : extraction, schemas, publication ou tout (défaut)"
  ],
  "outputs": [
    "Aucun fichier"
  ],
  "scripts": [
    {
      "name": "doctor.py",
      "role": "Vérifie les outils locaux et donne la commande d'installation des manquants.",
      "usage": "uv run scripts/doctor.py [extraction|schemas|publication|tout]",
      "report": {
        "format": "json",
        "description": "Un objet : chaque outil avec son statut (ok, manquant, absent pour un facultatif) et sa commande d'installation ; missing liste les obligatoires manquants.",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "tools",
            "missing",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "string"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "group",
                  "status"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "group": {
                    "enum": [
                      "extraction",
                      "schemas",
                      "publication"
                    ]
                  },
                  "status": {
                    "enum": [
                      "ok",
                      "manquant",
                      "absent"
                    ]
                  },
                  "install": {
                    "type": "string"
                  }
                }
              }
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "tous les outils obligatoires sont présents",
        "1": "au moins un outil obligatoire manque, ou groupe inconnu"
      }
    }
  ],
  "handoffs": [
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "un outil manque : il l'installe lui-même, rien n'est installé sans son accord"
    }
  ]
}
