{
  "skill": "urbanization-map",
  "level": "moyen",
  "inputs": [
    "Décision de diagram-brief : public et destination",
    "Description JSON du plan : title, audience, detail, vocabulary, zones (quartiers, ilots, apps) ; ou inventaire CSV, ou note Markdown avec son tableau (zone, quartier, ilot, application, statut)",
    "Pour pos_impact.py : le POS existant et des options d'architecture avec leur placement (options.json d'architecture-options)"
  ],
  "outputs": [
    "<sujet>.drawio en XML clair, à côté de sa description <sujet>.json ou de l'inventaire .csv",
    "Après export : <sujet>.drawio.png (une image par page), .svg ou .pdf",
    "Avec pos_impact.py : schemas/pos-option-<id>.json, le POS cible de chaque option, à construire avec pos_build.py"
  ],
  "scripts": [
    {
      "name": "pos_build.py",
      "role": "Construit le plan d'occupation des sols en draw.io (mise en page, styles de la charte, titre, légende, pages de zoom), puis le vérifie avec check_drawio.py du skill drawio-diagram s'il est installé.",
      "usage": "uv run scripts/pos_build.py SUJET.json|SUJET.csv|SUJET.md [--out SUJET.drawio] [--title TITRE] [--audience technique|\"non technique\"] [--detail zone|quartier|ilot|application] [--zoom] [--vocabulary pos|togaf] | --schema",
      "options": {
        "SUJET.json|SUJET.csv|SUJET.md": "description du plan ou inventaire des applications",
        "--out": "fichier .drawio (défaut : même nom)",
        "--title": "titre, prioritaire sur celui de la description",
        "--audience": "technique (défaut) ou non technique",
        "--detail": "niveau le plus fin affiché (défaut : application en technique, quartier en non technique)",
        "--zoom": "ajoute une page par zone, au niveau des applications",
        "--vocabulary": "pos (défaut) ou togaf : légende en capacités de niveau 1 à 3, zones empilées dans l'ordre donné",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
      "input": {
        "format": "json",
        "description": "Validée avant tout traitement : clé inconnue, type, valeur hors liste ou champ manquant donnent une erreur avec son chemin ; les clés qui commencent par _ sont des commentaires. Un inventaire CSV n'est pas concerné.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "zones"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "audience": {
              "enum": [
                "technique",
                "non technique"
              ]
            },
            "detail": {
              "enum": [
                "zone",
                "quartier",
                "ilot",
                "application"
              ]
            },
            "vocabulary": {
              "enum": [
                "pos",
                "togaf"
              ]
            },
            "zoom": {
              "type": "boolean"
            },
            "legend": {
              "enum": [
                "auto",
                true,
                false
              ]
            },
            "zones": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "quartiers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false,
                      "patternProperties": {
                        "^_": {}
                      },
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "ilots": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "name"
                            ],
                            "additionalProperties": false,
                            "patternProperties": {
                              "^_": {}
                            },
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "apps": {
                                "type": "array",
                                "items": {
                                  "$ref": "#/$defs/app"
                                }
                              }
                            }
                          }
                        },
                        "apps": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/app"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "$defs": {
            "app": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Un objet ; si la description est illisible, seulement input et errors.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "output",
                "pages",
                "zones",
                "quartiers",
                "ilots",
                "applications",
                "detail",
                "vocabulary",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "output": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pages": {
                  "type": "integer",
                  "minimum": 0
                },
                "zones": {
                  "type": "integer",
                  "minimum": 0
                },
                "quartiers": {
                  "type": "integer",
                  "minimum": 0
                },
                "ilots": {
                  "type": "integer",
                  "minimum": 0
                },
                "applications": {
                  "type": "integer",
                  "minimum": 0
                },
                "detail": {
                  "enum": [
                    "zone",
                    "quartier",
                    "ilot",
                    "application"
                  ]
                },
                "vocabulary": {
                  "enum": [
                    "pos",
                    "togaf"
                  ]
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "plan produit sans erreur",
        "1": "description illisible ou erreur"
      }
    },
    {
      "name": "pos_impact.py",
      "role": "Situe des options d'architecture dans le POS existant : vérifie le placement de chaque option (noms connus du POS, zone et quartier d'une nouvelle application), compte créations, évolutions, remplacements, réutilisations, redondances et flux entre zones, puis écrit le POS cible de chaque option pour pos_build.py. Lit le POS en JSON, CSV ou note Markdown, ou dans le vault du workflow (vault:<chemin>). Sert aussi de module à options_build.py.",
      "usage": "uv run scripts/pos_impact.py OPTIONS.json [--out-dir DOSSIER] | --schema",
      "options": {
        "OPTIONS.json": "description avec pos et options (id, name, components, flows, placement) : options.json d'architecture-options convient tel quel",
        "--out-dir": "dossier des POS cibles pos-option-<id>.json (défaut : schemas/ à côté du .json)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête"
      },
      "input": {
        "format": "json",
        "description": "Toute description qui a pos et des options avec leur placement ; les autres clés sont ignorées.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "pos",
            "options"
          ],
          "properties": {
            "pos": {
              "type": "string",
              "minLength": 1,
              "description": "POS existant du SI : description JSON ou inventaire CSV de urbanization-map, ou note Markdown avec le tableau zone, quartier, ilot, application, statut ; relatif au .json, ou « vault:<chemin> » pour un POS versé au vault du workflow (memory.vault de workflow.json)."
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "components"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "components": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "flows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "from",
                        "to"
                      ],
                      "properties": {
                        "from": {
                          "type": "string"
                        },
                        "to": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "placement": {
                    "type": "array",
                    "description": "Position de l'option dans le POS : applications créées (zone, quartier, îlot), modifiées, remplacées ou réutilisées.",
                    "items": {
                      "type": "object",
                      "required": [
                        "app",
                        "change"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "app": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Nom de l'application, tel que dans le POS pour une application existante."
                        },
                        "change": {
                          "enum": [
                            "nouvelle",
                            "a-faire-evoluer",
                            "a-remplacer",
                            "en-place",
                            "externe"
                          ]
                        },
                        "zone": {
                          "type": "string"
                        },
                        "quartier": {
                          "type": "string"
                        },
                        "ilot": {
                          "type": "string"
                        },
                        "component": {
                          "type": "string",
                          "description": "Composant de l'option qui correspond à cette application (flux entre zones)."
                        },
                        "coexists": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Nouvelle application dans un îlot déjà occupé : pourquoi elle coexiste avec l'existant (sinon redondance signalée)."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "POS lu, nombre d'applications, impacts de chaque option, POS cibles écrits.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "input",
            "pos",
            "apps",
            "impacts",
            "outputs",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "string"
            },
            "pos": {
              "type": [
                "string",
                "null"
              ]
            },
            "apps": {
              "type": "integer",
              "minimum": 0
            },
            "impacts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "option",
                  "new",
                  "evolve",
                  "replace",
                  "reuse",
                  "redundancies",
                  "cross_zone"
                ],
                "additionalProperties": false,
                "properties": {
                  "option": {
                    "type": "string"
                  },
                  "new": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "evolve": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "replace": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reuse": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "redundancies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cross_zone": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "impacts calculés et POS cibles écrits (avertissements possibles : redondance, option sans placement)",
        "1": "description invalide, POS illisible ou vide, application ou quartier inconnu du POS ; aucun fichier écrit"
      }
    }
  ],
  "requires": [
    {
      "skill": "drawio-diagram",
      "script": "check_drawio.py",
      "why": "vérifier le .drawio produit",
      "optional": true
    }
  ],
  "handoffs": [
    {
      "to": "diagram-export",
      "kind": "skill",
      "when": "exporter et relire l'image"
    },
    {
      "to": "drawio-diagram",
      "kind": "skill",
      "when": "retoucher le .drawio à la main, ou dessiner les flux entre applications (cartographie applicative)"
    }
  ]
}
