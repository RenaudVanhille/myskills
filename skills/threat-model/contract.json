{
  "skill": "threat-model",
  "level": "complexe",
  "inputs": [
    "Description JSON de l'architecture, celle de cloud_build.py (skill cloud-architecture) : groupes, services typés, flux avec protocole",
    "Ou la description cloud d'une option d'architecture-options (schemas/option-<id>.cloud.json)"
  ],
  "outputs": [
    "<sujet>.threats.md : frontières de confiance, flux qui les traversent, une menace type par catégorie STRIDE applicable, mesure type ; après threat_review.py, menaces précisées, mesures retenues, statuts et menaces écartées avec leur raison",
    "<sujet>.threats.json : les mêmes menaces en données, auxquelles le modèle répond par un fichier de décisions"
  ],
  "scripts": [
    {
      "name": "stride.py",
      "role": "Prépare le modèle de menaces STRIDE à partir de la même description : frontières de confiance, flux qui les traversent, une menace type par catégorie applicable, avec mesure type et statut à compléter.",
      "usage": "uv run scripts/stride.py SUJET.json [--out SUJET.threats.md] [--all-flows] [--vault VAULT --folder DOSSIER_DU_VAULT [--option ID]] | --schema",
      "options": {
        "SUJET.json": "description de l'architecture (celle de cloud_build.py)",
        "--out": "fichier Markdown (défaut : <sujet>.threats.md)",
        "--all-flows": "analyser aussi les flux internes (défaut : ceux qui traversent une frontière)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête",
        "--vault": "vault Obsidian où écrire aussi la note modele-menaces (compteurs, flux à risque), selon son ontologie",
        "--folder": "dossier des notes dans le vault, celui du workflow (Workflows/<titre>) ; avec --vault",
        "--option": "identifiant de l'option évaluée : relation evalue vers sa note Options/Option <id> du vault"
      },
      "input": {
        "format": "json",
        "same_as": "cloud-architecture/cloud_build.py",
        "description": "Description de l'architecture de cloud_build.py, copiée de son contrat par scripts/build.py.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "provider": {
              "enum": [
                "aws",
                "azure",
                "gcp",
                "k8s",
                "ovh",
                "cloud-temple",
                "outscale",
                "s3ns",
                "bleu",
                "numspot",
                "scaleway",
                "sur-site"
              ]
            },
            "view": {
              "enum": [
                "deployment",
                "network",
                "kubernetes",
                "dr",
                "pipeline",
                "threats"
              ]
            },
            "audience": {
              "enum": [
                "technique",
                "non technique"
              ]
            },
            "legend": {
              "enum": [
                "auto",
                true,
                false
              ]
            },
            "layout": {
              "enum": [
                "row",
                "column"
              ]
            },
            "wrap": {
              "type": "integer",
              "minimum": 1
            },
            "chain": {
              "type": "boolean"
            },
            "objectives": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "flows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/flow"
              }
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "provider": {
                    "enum": [
                      "aws",
                      "azure",
                      "gcp",
                      "k8s",
                      "ovh",
                      "cloud-temple",
                      "outscale",
                      "s3ns",
                      "bleu",
                      "numspot",
                      "scaleway",
                      "sur-site"
                    ]
                  },
                  "view": {
                    "enum": [
                      "deployment",
                      "network",
                      "kubernetes",
                      "dr",
                      "pipeline",
                      "threats"
                    ]
                  },
                  "audience": {
                    "enum": [
                      "technique",
                      "non technique"
                    ]
                  },
                  "legend": {
                    "enum": [
                      "auto",
                      true,
                      false
                    ]
                  },
                  "layout": {
                    "enum": [
                      "row",
                      "column"
                    ]
                  },
                  "wrap": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "chain": {
                    "type": "boolean"
                  },
                  "objectives": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/item"
                    }
                  },
                  "flows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/flow"
                    }
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "accept": {
              "type": "object",
              "description": "constats acceptés : règle (SEC-05) ou règle@élément (SEC-05@F2, OPS-01@aws) -> raison",
              "additionalProperties": false,
              "patternProperties": {
                "^[A-Z]+-[0-9]{2}(@.+)?$": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "qualifications": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "description": "qualifications exigées de l'hébergeur (secnumcloud, hds) : wa_check.py signale un hébergeur qui ne les a pas (catalogue shared/providers.json)"
            }
          },
          "$defs": {
            "item": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/item"
                      }
                    },
                    "layout": {
                      "enum": [
                        "row",
                        "column"
                      ]
                    },
                    "wrap": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "chain": {
                      "type": "boolean"
                    },
                    "state": {
                      "enum": [
                        "active",
                        "passive"
                      ]
                    },
                    "boundary": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "count": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    },
                    "kind": {
                      "enum": [
                        "external",
                        "process",
                        "store",
                        "network"
                      ]
                    },
                    "w": {
                      "type": "number",
                      "minimum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 1
                    }
                  }
                }
              ]
            },
            "flow": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^_": {}
              },
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "protocol": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "style": {
                  "enum": [
                    "sync",
                    "async",
                    "replication"
                  ]
                },
                "both": {
                  "type": "boolean"
                },
                "encrypted": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Un objet ; si la description est illisible, seulement input et errors.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "output",
                "model",
                "boundaries",
                "elements",
                "flows",
                "crossing",
                "threats",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "output": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "boundaries": {
                  "type": "integer",
                  "minimum": 0
                },
                "elements": {
                  "type": "integer",
                  "minimum": 0
                },
                "flows": {
                  "type": "integer",
                  "minimum": 0
                },
                "crossing": {
                  "type": "integer",
                  "minimum": 0
                },
                "threats": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "vault": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "vault",
                        "folder",
                        "notes",
                        "removed"
                      ],
                      "properties": {
                        "vault": {
                          "type": "string"
                        },
                        "folder": {
                          "type": "string"
                        },
                        "notes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "removed": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  ]
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "<sujet>.threats.json : les menaces en données, pour threat_review.py"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "modèle produit sans erreur",
        "1": "description illisible ou erreur"
      }
    },
    {
      "name": "threat_review.py",
      "role": "Reporte dans le modèle STRIDE les décisions du modèle sur les menaces, données dans un court fichier JSON (statut, mesure retenue, menace précisée, raison) : vérifie chaque décision, réécrit <sujet>.threats.md depuis <sujet>.threats.json, compte les menaces par statut et celles encore à analyser.",
      "usage": "uv run scripts/threat_review.py DECISIONS.json [--out SUJET.threats.md] [--fail-undecided] | --schema",
      "options": {
        "DECISIONS.json": "décisions : model (le .threats.json de stride.py) et threats, par identifiant M001...",
        "--out": "modèle Markdown réécrit (défaut : celui de model, en .md)",
        "--fail-undecided": "erreur s'il reste des menaces à analyser",
        "--schema": "affiche le schéma JSON des décisions sur une ligne, puis s'arrête"
      },
      "input": {
        "format": "json",
        "description": "Décisions sur les menaces du modèle STRIDE.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "model",
            "threats"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "<sujet>.threats.json écrit par stride.py, relatif au fichier de décisions"
            },
            "threats": {
              "type": "object",
              "description": "une entrée par menace décidée, par identifiant (M001...) ; les autres restent à analyser",
              "propertyNames": {
                "pattern": "^M\\d{3,}$"
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "status"
                ],
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "a-traiter",
                      "traitee",
                      "acceptee",
                      "ecartee"
                    ]
                  },
                  "measure": {
                    "type": "string",
                    "minLength": 1,
                    "description": "mesure retenue (obligatoire si traitee)"
                  },
                  "threat": {
                    "type": "string",
                    "minLength": 1,
                    "description": "menace précisée pour le contexte, à la place de la menace type"
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1,
                    "description": "raison, obligatoire si acceptee (celle de l'utilisateur) ou ecartee"
                  },
                  "element": {
                    "type": "string",
                    "description": "élément visé, pour vérifier que l'identifiant n'a pas changé"
                  }
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Menaces, décisions reportées, menaces encore à analyser, compte par statut.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "input",
            "output",
            "threats",
            "decided",
            "undecided",
            "by_status",
            "errors",
            "warnings"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "string"
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "threats": {
              "type": "integer",
              "minimum": 0
            },
            "decided": {
              "type": "integer",
              "minimum": 0
            },
            "undecided": {
              "type": "integer",
              "minimum": 0
            },
            "by_status": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "a-traiter",
                "traitee",
                "acceptee",
                "ecartee"
              ],
              "properties": {
                "a-traiter": {
                  "type": "integer",
                  "minimum": 0
                },
                "traitee": {
                  "type": "integer",
                  "minimum": 0
                },
                "acceptee": {
                  "type": "integer",
                  "minimum": 0
                },
                "ecartee": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "exit_codes": {
        "0": "décisions reportées dans le modèle",
        "1": "décisions invalides (menace inconnue, mesure ou raison manquante, identifiant décalé) ou modèle illisible"
      }
    }
  ],
  "requires": [
    {
      "skill": "cloud-architecture",
      "script": "cloud_build.py",
      "why": "lire la description comme le schéma : types de services, groupes, frontières et numéros de flux F1, F2..."
    }
  ],
  "handoffs": [
    {
      "to": "cloud-architecture",
      "kind": "skill",
      "when": "schéma des menaces (cloud_build.py --view threats), mêmes numéros de flux"
    },
    {
      "to": "well-architected-review",
      "kind": "skill",
      "when": "contrôler aussi les piliers Well-Architected du fournisseur"
    },
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "compléter avec lui les mesures retenues et les statuts des menaces"
    }
  ],
  "vault": {
    "writes": [
      "modele-menaces"
    ],
    "reads": true
  }
}
