{
  "skill": "threat-model",
  "level": "complexe",
  "inputs": [
    "Description JSON de l'architecture, celle de cloud_build.py (skill cloud-architecture) : groupes, services typés, flux avec protocole",
    "Ou la description cloud d'une option d'architecture-options (schemas/option-<id>.cloud.json)"
  ],
  "outputs": [
    "<sujet>.threats.md : frontières de confiance, flux qui les traversent, une menace type par catégorie STRIDE applicable, mesure type et statut à compléter"
  ],
  "scripts": [
    {
      "name": "stride.py",
      "role": "Prépare le modèle de menaces STRIDE à partir de la même description : frontières de confiance, flux qui les traversent, une menace type par catégorie applicable, avec mesure type et statut à compléter.",
      "usage": "uv run scripts/stride.py SUJET.json [--out SUJET.threats.md] [--all-flows] [--vault VAULT --folder DOSSIER_DU_VAULT [--option ID]] | --schema",
      "options": {
        "SUJET.json": "description de l'architecture (celle de cloud_build.py)",
        "--out": "fichier Markdown (défaut : <sujet>.threats.md)",
        "--all-flows": "analyser aussi les flux internes (défaut : ceux qui traversent une frontière)",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête",
        "--vault": "vault Obsidian où écrire aussi la note modele-menaces (compteurs, flux à risque), selon son ontologie",
        "--folder": "dossier des notes dans le vault, celui du workflow (Workflows/<titre>) ; avec --vault",
        "--option": "identifiant de l'option évaluée : relation evalue vers sa note Options/Option <id> du vault"
      },
      "input": {
        "format": "json",
        "same_as": "cloud-architecture/cloud_build.py",
        "description": "Description de l'architecture de cloud_build.py, copiée de son contrat par scripts/build.py.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "provider": {
              "enum": [
                "aws",
                "azure",
                "gcp",
                "k8s",
                "ovh",
                "cloud-temple",
                "outscale",
                "s3ns",
                "bleu",
                "numspot",
                "scaleway",
                "sur-site"
              ]
            },
            "view": {
              "enum": [
                "deployment",
                "network",
                "kubernetes",
                "dr",
                "pipeline",
                "threats"
              ]
            },
            "audience": {
              "enum": [
                "technique",
                "non technique"
              ]
            },
            "legend": {
              "enum": [
                "auto",
                true,
                false
              ]
            },
            "layout": {
              "enum": [
                "row",
                "column"
              ]
            },
            "wrap": {
              "type": "integer",
              "minimum": 1
            },
            "chain": {
              "type": "boolean"
            },
            "objectives": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "flows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/flow"
              }
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "provider": {
                    "enum": [
                      "aws",
                      "azure",
                      "gcp",
                      "k8s",
                      "ovh",
                      "cloud-temple",
                      "outscale",
                      "s3ns",
                      "bleu",
                      "numspot",
                      "scaleway",
                      "sur-site"
                    ]
                  },
                  "view": {
                    "enum": [
                      "deployment",
                      "network",
                      "kubernetes",
                      "dr",
                      "pipeline",
                      "threats"
                    ]
                  },
                  "audience": {
                    "enum": [
                      "technique",
                      "non technique"
                    ]
                  },
                  "legend": {
                    "enum": [
                      "auto",
                      true,
                      false
                    ]
                  },
                  "layout": {
                    "enum": [
                      "row",
                      "column"
                    ]
                  },
                  "wrap": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "chain": {
                    "type": "boolean"
                  },
                  "objectives": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/item"
                    }
                  },
                  "flows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/flow"
                    }
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "accept": {
              "type": "object",
              "description": "constats acceptés : règle (SEC-05) ou règle@élément (SEC-05@F2, OPS-01@aws) -> raison",
              "additionalProperties": false,
              "patternProperties": {
                "^[A-Z]+-[0-9]{2}(@.+)?$": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "qualifications": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "description": "qualifications exigées de l'hébergeur (secnumcloud, hds) : wa_check.py signale un hébergeur qui ne les a pas (catalogue shared/providers.json)"
            }
          },
          "$defs": {
            "item": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/item"
                      }
                    },
                    "layout": {
                      "enum": [
                        "row",
                        "column"
                      ]
                    },
                    "wrap": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "chain": {
                      "type": "boolean"
                    },
                    "state": {
                      "enum": [
                        "active",
                        "passive"
                      ]
                    },
                    "boundary": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "count": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    },
                    "kind": {
                      "enum": [
                        "external",
                        "process",
                        "store",
                        "network"
                      ]
                    },
                    "w": {
                      "type": "number",
                      "minimum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 1
                    }
                  }
                }
              ]
            },
            "flow": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^_": {}
              },
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "protocol": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "style": {
                  "enum": [
                    "sync",
                    "async",
                    "replication"
                  ]
                },
                "both": {
                  "type": "boolean"
                },
                "encrypted": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Un objet ; si la description est illisible, seulement input et errors.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "output",
                "boundaries",
                "elements",
                "flows",
                "crossing",
                "threats",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "output": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "boundaries": {
                  "type": "integer",
                  "minimum": 0
                },
                "elements": {
                  "type": "integer",
                  "minimum": 0
                },
                "flows": {
                  "type": "integer",
                  "minimum": 0
                },
                "crossing": {
                  "type": "integer",
                  "minimum": 0
                },
                "threats": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "vault": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "vault",
                        "folder",
                        "notes",
                        "removed"
                      ],
                      "properties": {
                        "vault": {
                          "type": "string"
                        },
                        "folder": {
                          "type": "string"
                        },
                        "notes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "removed": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "modèle produit sans erreur",
        "1": "description illisible ou erreur"
      }
    }
  ],
  "requires": [
    {
      "skill": "cloud-architecture",
      "script": "cloud_build.py",
      "why": "lire la description comme le schéma : types de services, groupes, frontières et numéros de flux F1, F2..."
    }
  ],
  "handoffs": [
    {
      "to": "cloud-architecture",
      "kind": "skill",
      "when": "schéma des menaces (cloud_build.py --view threats), mêmes numéros de flux"
    },
    {
      "to": "well-architected-review",
      "kind": "skill",
      "when": "contrôler aussi les piliers Well-Architected du fournisseur"
    },
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "compléter avec lui les mesures retenues et les statuts des menaces"
    }
  ],
  "vault": {
    "writes": [
      "modele-menaces"
    ],
    "reads": true
  }
}
