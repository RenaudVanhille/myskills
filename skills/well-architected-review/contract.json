{
  "skill": "well-architected-review",
  "level": "moyen",
  "inputs": [
    "Description JSON de l'architecture, celle de cloud_build.py (skill cloud-architecture) ; à la définition, la description cloud d'une option (schemas/option-<id>.cloud.json d'architecture-options)",
    "Facultatif : accept, les écarts acceptés avec leur raison"
  ],
  "outputs": [
    "<sujet>.wa.md : synthèse par pilier, constats (règle, pilier, gravité, élément, correction, référence du cadre), points hors du schéma"
  ],
  "scripts": [
    {
      "name": "wa_check.py",
      "role": "Contrôle la même description contre l'AWS Well-Architected Framework, l'Azure Well-Architected Framework et le Google Cloud Well-Architected Framework (fiabilité, sécurité, excellence opérationnelle, performances, coûts, durabilité) et contre les conventions de schéma des fournisseurs (imbrication région, VPC/VNet, zone, sous-réseau ; icônes officielles) : un constat par règle enfreinte, avec pilier, gravité, élément, correction et référence du cadre ; écrit <sujet>.wa.md.",
      "usage": "uv run scripts/wa_check.py SUJET.json [--out SUJET.wa.md] [--scope tout|piliers|conventions] [--fail-on haute|moyenne|basse|aucune] [--vault VAULT --folder DOSSIER_DU_VAULT [--option ID]] | --rules | --schema",
      "options": {
        "SUJET.json": "description de l'architecture (celle de cloud_build.py)",
        "--out": "fichier Markdown (défaut : <sujet>.wa.md)",
        "--scope": "règles appliquées : piliers à la définition de l'architecture (description d'une option, avant tout schéma), conventions au dessin, tout (défaut) pour un schéma terminé",
        "--fail-on": "code de sortie 1 dès un constat non accepté de cette gravité ou plus (défaut : haute ; aucune : jamais)",
        "--rules": "liste les règles (identifiant, pilier, gravité), puis s'arrête",
        "--schema": "affiche le schéma JSON de la description sur une ligne, puis s'arrête",
        "--vault": "vault Obsidian où écrire aussi la revue, selon son ontologie : une note revue-well-architected et une note par constat, reliées à la note de l'option",
        "--folder": "dossier des notes dans le vault, celui du workflow (Workflows/<titre>) ; avec --vault",
        "--option": "identifiant de l'option évaluée : relation evalue vers sa note Options/Option <id> du vault"
      },
      "input": {
        "format": "json",
        "same_as": "cloud-architecture/cloud_build.py",
        "description": "Description de l'architecture de cloud_build.py, copiée de son contrat par scripts/build.py.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "title": {
              "type": "string"
            },
            "provider": {
              "enum": [
                "aws",
                "azure",
                "gcp",
                "k8s",
                "ovh",
                "cloud-temple",
                "outscale",
                "s3ns",
                "bleu",
                "numspot",
                "scaleway",
                "sur-site"
              ]
            },
            "view": {
              "enum": [
                "deployment",
                "network",
                "kubernetes",
                "dr",
                "pipeline",
                "threats"
              ]
            },
            "audience": {
              "enum": [
                "technique",
                "non technique"
              ]
            },
            "legend": {
              "enum": [
                "auto",
                true,
                false
              ]
            },
            "layout": {
              "enum": [
                "row",
                "column"
              ]
            },
            "wrap": {
              "type": "integer",
              "minimum": 1
            },
            "chain": {
              "type": "boolean"
            },
            "objectives": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "flows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/flow"
              }
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^_": {}
                },
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "provider": {
                    "enum": [
                      "aws",
                      "azure",
                      "gcp",
                      "k8s",
                      "ovh",
                      "cloud-temple",
                      "outscale",
                      "s3ns",
                      "bleu",
                      "numspot",
                      "scaleway",
                      "sur-site"
                    ]
                  },
                  "view": {
                    "enum": [
                      "deployment",
                      "network",
                      "kubernetes",
                      "dr",
                      "pipeline",
                      "threats"
                    ]
                  },
                  "audience": {
                    "enum": [
                      "technique",
                      "non technique"
                    ]
                  },
                  "legend": {
                    "enum": [
                      "auto",
                      true,
                      false
                    ]
                  },
                  "layout": {
                    "enum": [
                      "row",
                      "column"
                    ]
                  },
                  "wrap": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "chain": {
                    "type": "boolean"
                  },
                  "objectives": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/item"
                    }
                  },
                  "flows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/flow"
                    }
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "accept": {
              "type": "object",
              "description": "constats acceptés : règle (SEC-05) ou règle@élément (SEC-05@F2, OPS-01@aws) -> raison",
              "additionalProperties": false,
              "patternProperties": {
                "^[A-Z]+-[0-9]{2}(@.+)?$": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "qualifications": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "description": "qualifications exigées de l'hébergeur (secnumcloud, hds) : wa_check.py signale un hébergeur qui ne les a pas (catalogue shared/providers.json)"
            }
          },
          "$defs": {
            "item": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/item"
                      }
                    },
                    "layout": {
                      "enum": [
                        "row",
                        "column"
                      ]
                    },
                    "wrap": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "chain": {
                      "type": "boolean"
                    },
                    "state": {
                      "enum": [
                        "active",
                        "passive"
                      ]
                    },
                    "boundary": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": {}
                  },
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "count": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    },
                    "kind": {
                      "enum": [
                        "external",
                        "process",
                        "store",
                        "network"
                      ]
                    },
                    "w": {
                      "type": "number",
                      "minimum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 1
                    }
                  }
                }
              ]
            },
            "flow": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^_": {}
              },
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "protocol": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "style": {
                  "enum": [
                    "sync",
                    "async",
                    "replication"
                  ]
                },
                "both": {
                  "type": "boolean"
                },
                "encrypted": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "report": {
        "format": "json",
        "description": "Un objet ; si la description est illisible, seulement input, errors et warnings. findings va du plus grave au moins grave ; un constat accepté garde sa raison dans accepted et ne compte pas dans counts.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "input",
                "output",
                "providers",
                "scope",
                "rules",
                "counts",
                "findings",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "output": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "providers": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "aws",
                      "azure",
                      "gcp",
                      "k8s",
                      "ovh",
                      "cloud-temple",
                      "outscale",
                      "s3ns",
                      "bleu",
                      "numspot",
                      "scaleway",
                      "sur-site"
                    ]
                  }
                },
                "scope": {
                  "enum": [
                    "tout",
                    "piliers",
                    "conventions"
                  ]
                },
                "rules": {
                  "type": "integer",
                  "minimum": 0
                },
                "counts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "haute",
                    "moyenne",
                    "basse",
                    "acceptés"
                  ],
                  "properties": {
                    "haute": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "moyenne": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "basse": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "acceptés": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "rule",
                      "pillar",
                      "severity",
                      "element",
                      "message",
                      "fix",
                      "ref",
                      "accepted"
                    ],
                    "properties": {
                      "rule": {
                        "type": "string",
                        "pattern": "^[A-Z]+-[0-9]{2}$"
                      },
                      "pillar": {
                        "enum": [
                          "reliability",
                          "security",
                          "operations",
                          "performance",
                          "cost",
                          "sustainability",
                          "conventions"
                        ]
                      },
                      "severity": {
                        "enum": [
                          "haute",
                          "moyenne",
                          "basse"
                        ]
                      },
                      "element": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      },
                      "fix": {
                        "type": "string"
                      },
                      "ref": {
                        "type": "string"
                      },
                      "accepted": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "vault": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "vault",
                        "folder",
                        "notes",
                        "removed"
                      ],
                      "properties": {
                        "vault": {
                          "type": "string"
                        },
                        "folder": {
                          "type": "string"
                        },
                        "notes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "removed": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "input",
                "errors",
                "warnings"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "exit_codes": {
        "0": "revue écrite, aucun constat non accepté au seuil --fail-on",
        "1": "description illisible, erreur, ou constat non accepté au seuil --fail-on ; le rapport et <sujet>.wa.md sont tout de même produits sauf erreur"
      }
    }
  ],
  "requires": [
    {
      "skill": "cloud-architecture",
      "script": "cloud_build.py",
      "why": "lire la description comme le schéma : types de services, groupes, frontières et numéros de flux F1, F2..."
    }
  ],
  "handoffs": [
    {
      "to": "cloud-architecture",
      "kind": "skill",
      "when": "corriger la description puis reconstruire le schéma"
    },
    {
      "to": "threat-model",
      "kind": "skill",
      "when": "préparer aussi le modèle de menaces STRIDE"
    },
    {
      "to": "utilisateur",
      "kind": "utilisateur",
      "when": "un écart est voulu : sa raison va dans accept"
    }
  ],
  "vault": {
    "writes": [
      "revue-well-architected",
      "constat"
    ],
    "reads": true
  }
}
