{
  "_doc": "Ontologie du vault Obsidian, mémoire partagée des agents : types de notes, propriétés du frontmatter, relations typées (propriétés à wikilinks) et tags normalisés. Seule source ; schéma : shared/schemas/vault-ontology.schema.json. scripts/build.py la copie, avec shared/scripts/vault_ontology.py, dans scripts/lib/ des skills dont le contrat déclare `vault`. Ajouter un type ou une relation ici suffit : aucun code à changer. Changer le sens d'une propriété existante demande d'augmenter version.",
  "version": 1,
  "tags": {
    "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$",
    "type_prefix": "type",
    "_doc": "Tags en minuscules, sans accents, à tirets, hiérarchiques (/). Chaque note typée porte type/<type> ; chaque facette d'un type donne <propriété>/<valeur> (statut/retenue, priorite/indispensable). Les autres tags sont libres mais suivent le motif."
  },
  "labels": {"base-legale": "base légale", "gravite": "gravité", "priorite": "priorité", "categorie": "catégorie", "flux-a-risque": "flux à risque", "hebergeur": "hébergeur", "complexite": "complexité", "a-faire": "à faire", "a-faire-evoluer": "à faire évoluer", "a-remplacer": "à remplacer", "a-reprendre": "à reprendre", "abandonnee": "abandonnée", "accepte": "accepté", "acceptee": "acceptée", "attenue": "atténué", "avant-vente": "avant-vente", "compte-rendu": "compte rendu", "conformite": "conformité", "corrige": "corrigé", "cout": "coût", "defavorable": "défavorable", "depasse": "dépassé", "disponibilite": "disponibilité", "elevee": "élevée", "en-cours": "en cours", "en-place": "en place", "en-revue": "en revue", "encadres": "encadrés", "evolutivite": "évolutivité", "exploitabilite": "exploitabilité", "gagnee": "gagnée", "hors-perimetre": "hors périmètre", "hypothese": "hypothèse", "interet-legitime": "intérêt légitime", "interet-vital": "intérêt vital", "interoperabilite": "interopérabilité", "livree": "livrée", "maintenabilite": "maintenabilité", "mission-publique": "mission publique", "non-encadres": "non encadrés", "non-fixe": "non fixé", "non-fonctionnelle": "non fonctionnelle", "non-requise": "non requise", "obligation-legale": "obligation légale", "portabilite": "portabilité", "presentation": "présentation", "procedure": "procédure", "proposee": "proposée", "rejetee": "rejetée", "remplacee": "remplacée", "reserves": "réserves", "respecte": "respecté", "retiree": "retirée", "sautee": "sautée", "securite": "sécurité", "specification": "spécification", "tres-elevee": "très élevée", "utilisabilite": "utilisabilité", "validee": "validée"},
  "_labels": "Libellé affiché dans le corps des notes pour une valeur de propriété sans accents ni espaces (a-faire : à faire). Une valeur absente s'affiche telle quelle, tirets remplacés par des espaces.",
  "common": {
    "type": {"type": "string", "description": "Type de la note, une clé de types."},
    "id": {"type": "string", "minLength": 1, "description": "Identifiant stable dans son workflow ou son référentiel (EF-001, D-003, option-A)."},
    "genere": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "Skill qui a écrit la note et la réécrit ; absente : note tenue par l'utilisateur, jamais touchée par un script."},
    "ontologie": {"type": "integer", "minimum": 1, "description": "Version de l'ontologie suivie par la note."},
    "tags": {"type": "array", "items": {"type": "string"}},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "string", "description": "Document ou fichier d'origine."},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"}
  },
  "types": {
    "mission": {
      "label": "Mission",
